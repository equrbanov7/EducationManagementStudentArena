<mxfile host="app.diagrams.net" agent="EMSArena schema generator"><diagram name="EMSArena — Cədvəl əlaqələri" id="ems-rels"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legend" value="&lt;b style=&#x27;font-size:15px;&#x27;&gt;EMSArena — Cədvəl əlaqə xəritəsi&lt;/b&gt;&lt;br/&gt;&lt;span style=&#x27;font-size:11px;color:#5b6b82;&#x27;&gt;94 cədvəl · 245 əlaqə · domenlərə görə qruplaşdırılıb&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Oxunuş:&lt;/b&gt; uşaq cədvəl → &lt;i&gt;sahə&lt;/i&gt; → valideyn cədvəl. Ox həmişə &quot;bir&quot; tərəfə (valideynə) baxır.&lt;br/&gt;&lt;b&gt;İki onurğa:&lt;/b&gt; &lt;b&gt;Organization&lt;/b&gt; (tenant) və &lt;b&gt;User&lt;/b&gt; (aktor) — demək olar hər cədvəl bunlardan birinə bağlıdır.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ox rəngləri (ON DELETE):&lt;/b&gt;&amp;nbsp; &lt;font color=&#x27;#c8342b&#x27;&gt;■ CASCADE&lt;/font&gt; (valideyn silinsə uşaq da silinir)&amp;nbsp; &lt;font color=&#x27;#a86500&#x27;&gt;■ SET_NULL&lt;/font&gt; (əlaqə boşalır)&amp;nbsp; &lt;font color=&#x27;#345bb0&#x27;&gt;■ PROTECT&lt;/font&gt; (silmək olmaz)&amp;nbsp; &lt;font color=&#x27;#7a45e0&#x27;&gt;▪ M2M&lt;/font&gt; (çox-çoxa, kəsik xətt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d4e3;align=left;verticalAlign=top;spacing=14;fontSize=12;fontColor=#16202f;shadow=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1650" height="146" as="geometry"/></mxCell><mxCell id="c_core" value="NÜVƏ · TƏŞKİLAT — tenant, struktur, rol, üzvlük" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f0ff;strokeColor=#2158d6;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#2158d6;align=center;spacingTop=8;arcSize=4;container=1;collapsible=0;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="282" height="548