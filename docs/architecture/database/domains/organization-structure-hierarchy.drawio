<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram name="Organization Structure Hierarchy"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" value="EMSArena Organization Structure: Faculty / Kafedra are OrgUnit subtypes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#ffffff;strokeColor=#455A64;fontSize=13;fontStyle=1;fontSize=18;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="900" height="48" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid boxes = real DB table/model&lt;br&gt;Dashed boxes = visual subtype of organizations_orgunit&lt;br&gt;FK fields shown on connector labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="25" width="330" height="95" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;organizations_organization&lt;/b&gt;&lt;br&gt;Organization&lt;br&gt;id PK&lt;br&gt;name, slug, org_type&lt;br&gt;owner_id FK -&gt; auth_user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="260" height="120" as="geometry" /></mxCell><mxCell id="n3" value="&lt;b&gt;organizations_orgunit&lt;/b&gt;&lt;br&gt;OrgUnit (real table)&lt;br&gt;id PK&lt;br&gt;organization_id FK&lt;br&gt;parent_id FK self&lt;br&gt;unit_type, name, code, head_id&lt;br&gt;level, path, is_active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="320" height="150" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Faculty&lt;/b&gt;&lt;br&gt;OrgUnit(unit_type=&quot;faculty&quot;)&lt;br&gt;Fakültə ayrıca table deyil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;fontColor=#000000;strokeColor=#455A64;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="390" width="260" height="110" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Kafedra / Department&lt;/b&gt;&lt;br&gt;OrgUnit(unit_type=&quot;chair&quot; və ya &quot;department&quot;)&lt;br&gt;Kafedra ayrıca table deyil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;fontColor=#000000;strokeColor=#455A64;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="390" width="300" height="110" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;Specialty / Program area&lt;/b&gt;&lt;br&gt;OrgUnit(unit_type=&quot;specialty&quot;)&lt;br&gt;İxtisas ağacda child unit kimi saxlanır" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE775;fontColor=#000000;strokeColor=#455A64;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="300" height="110" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Academic Group / Class&lt;/b&gt;&lt;br&gt;OrgUnit(unit_type=&quot;group&quot; / &quot;class&quot;)&lt;br&gt;və ya exams_studentgroup.org_unit FK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;fontColor=#000000;strokeColor=#455A64;fontSize=13;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="320" height="120" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;courses_course&lt;/b&gt;&lt;br&gt;unit_id FK -&gt; OrgUnit&lt;br&gt;period_id FK -&gt; AcademicPeriod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="850" y="600" width="280" height="105" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;organizations_membership&lt;/b&gt;&lt;br&gt;scope_unit_id FK -&gt; OrgUnit&lt;br&gt;role_id FK -&gt; Role&lt;br&gt;user_id FK -&gt; auth_user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="300" height="120" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;Why this is shown separately?&lt;/b&gt;&lt;br&gt;DB-də Faculty/Kafedra ayrı model deyil. Sistem flexible tree pattern istifadə edir: eyni OrgUnit table, fərqli unit_type. Bu diaqram həmin subtype-ları vizual olaraq ayırır ki, struktur oxunsun." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;fontColor=#000000;strokeColor=#455A64;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="760" width="620" height="95" as="geometry" /></mxCell><mxCell id="e0" value="organization_id" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="unit_type=faculty" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="parent_id" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="parent_id" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="parent_id / org_unit" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="scope_unit_id" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n3" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="unit_id" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="student/teacher scope" style="endArrow=block;html=1;rounded=0;strokeColor=#37474F;fontSize=11;strokeWidth=1.5;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
