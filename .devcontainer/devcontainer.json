{
  "name": "EMSArena Agent PostgreSQL",
  "dockerComposeFile": ["../docker-compose.agent.yml"],
  "service": "agent",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "postCreateCommand": "python manage.py check",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort"
      ]
    }
  }
}
