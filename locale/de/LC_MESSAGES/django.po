#, python-format
msgctxt "accounts.syllabus"
msgid "Bu qrup da %(group)s qrupunun sillabusunu istifadə edir — bir sillabus: təsdiq və dəyişikliklər hər iki jurnal üçün ortaqdır."
msgstr "Diese Gruppe nutzt jetzt den Syllabus der Gruppe %(group)s — ein Syllabus: Freigabe und Änderungen gelten für beide Kursbücher."

msgctxt "accounts.syllabus"
