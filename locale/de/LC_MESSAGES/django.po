msgctxt "applications"
msgid "Cavab ver"
msgstr "Antworten"

msgctxt "applications"
msgid "Müraciət sahibinin görəcəyi cavab"
msgstr "Die Antwort, die der Antragsteller sieht"

msgctxt "applications"
msgid ""
"Cavab mətni ən azı 10 simvol olmalıdır — müraciət sahibi məhz bu mətni "
"görəcək."
msgstr ""
"Die Antwort muss mindestens 10 Zeichen lang sein — der Antragsteller sieht "
"genau diesen Text."

msgctxt "applications"
msgid "Həll olundu — bağla"
msgstr "Erledigt — schließen"

