msgstr "Es darf nicht mehr als %(max)s Spalten geben."

msgctxt "registrar.exam_score_entry"
msgid "Sütun sayı 10-dan çox ola bilməz."
msgstr "Es darf nicht mehr als 10 Spalten geben."

msgctxt "registrar.exam_score_entry"
