msgid "DƏRS TARİXİ"
msgstr "UNTERRICHTSDATUM"

msgctxt "registrar.journal_history"
msgid "Tarix axtar…"
msgstr "Datum suchen…"

msgctxt "registrar.journal_history"
msgid "Uyğun tarix yoxdur"
msgstr "Kein passendes Datum"

msgctxt "registrar.journal_history"
msgid "Bütün tarixlər"
msgstr "Alle Daten"

msgctxt "registrar.journal_history"
msgid "TƏLƏBƏ"
msgstr "STUDIERENDE"

msgctxt "registrar.journal_history"
msgid "Ad və ya soyad…"
msgstr "Vor- oder Nachname…"

msgctxt "registrar.journal_history"
msgid "Qeyd növü"
msgstr "Eintragsart"

msgctxt "registrar.journal_history"
msgid "Hamısı"
msgstr "Alle"

msgctxt "registrar.journal_history"
msgid "Komponent"
msgstr "Komponente"

msgctxt "registrar.journal_history"
msgid "Yekun"
msgstr "Abschluss"

msgctxt "registrar.journal_history"
msgid "Sənədli düzəlişlər"
msgstr "Dokumentierte Korrekturen"

msgctxt "registrar.journal_history"
msgid "Yüklənir…"
msgstr "Wird geladen…"

msgctxt "registrar.journal_history"
msgid "Tarixçə açıla bilmədi. Səhifəni yeniləyib yenidən cəhd edin."
msgstr ""
"Der Verlauf konnte nicht geladen werden. Laden Sie die Seite neu und "
"versuchen Sie es erneut."

msgctxt "registrar.journal_history"
msgid "Hələ dəyişiklik qeydə alınmayıb"
msgstr "Noch keine Änderungen erfasst"

msgctxt "registrar.journal_history"
msgid ""
"Bal, davamiyyət, komponent və düzəlişlər yazılan kimi burada görünəcək."
msgstr ""
"Punkte, Anwesenheit, Komponenten und Korrekturen erscheinen hier, sobald sie"
" gespeichert werden."

msgctxt "registrar.journal_history"
msgid "Süzgəcə uyğun qeyd yoxdur"
msgstr "Keine Einträge entsprechen dem Filter"

msgctxt "registrar.journal_history"
msgid "Süzgəci dəyişin və ya aşağıdan köhnə qeydləri də yükləyin."
msgstr "Ändern Sie den Filter oder laden Sie unten ältere Einträge."

msgctxt "registrar.journal_history"
msgid ""
"Tələbə və növ süzgəci yüklənmiş qeydlər üzrə işləyir — köhnə qeydlər üçün "
"«Daha çox» basın."
msgstr ""
"Die Filter nach Studierenden und Art gelten für geladene Einträge — drücken "
"Sie „Mehr“ für ältere."

msgctxt "registrar.journal_history"
msgid "Daha çox"
msgstr "Mehr"

msgctxt "registrar.journal_history"
msgid "Bağla"
msgstr "Schließen"

msgctxt "registrar.journal_history"
msgid "Tələbə"
msgstr "Studierende/r"

msgctxt "registrar.journal_history"
msgid "Nə dəyişdi"
msgstr "Was sich geändert hat"

msgctxt "registrar.journal_history"
msgid "Köhnə → yeni"
msgstr "Alt → neu"

msgctxt "registrar.journal_history"
msgid "Kim, nə vaxt, nəyi dəyişib — jurnalın dəyişiklik tarixçəsi"
msgstr "Wer hat was wann geändert — der Änderungsverlauf des Journals"

msgctxt "registrar.journal_history"
msgid "Tarixçə"
msgstr "Verlauf"

msgctxt "registrar.journal_history"
msgid "Bu dərsin tarixçəsi"
msgstr "Verlauf dieser Unterrichtseinheit"

msgctxt "registrar.journal_activation"
msgid "Bu cədvəl dərsi bu fənnə aid deyil."
msgstr "Dieser Stundenplan-Termin gehört nicht zu diesem Fach."

msgctxt "registrar.journal_activation"
msgid ""
"Bu cədvəl dərsi %(date)s tarixində keçirilmir (həftə günü və ya üst/alt "
"həftə uyğun deyil)."
msgstr ""
"Dieser Stundenplan-Termin findet am %(date)s nicht statt (Wochentag oder "
"gerade/ungerade Woche stimmt nicht überein)."

msgctxt "registrar.journal_activation"
msgid ""
"Bu tarix və saatda cədvəldə bu fənnin dərsi yoxdur — cədvəldən kənar dərs "
"üçün səbəbi yazın (məs. əvəzetmə, kompensasiya dərsi). Cədvəldəki dərs üçün "
"jurnalın üstündəki «Aktivləşdir» düyməsini işlədin."
msgstr ""
"Der Stundenplan enthält zu diesem Datum und dieser Uhrzeit keine "
"Unterrichtseinheit dieses Fachs — geben Sie einen Grund für eine "
"Unterrichtseinheit außerhalb des Stundenplans an (z. B. Vertretung, "
"Nachholtermin). Für eine Unterrichtseinheit laut Stundenplan verwenden Sie "
"die Schaltfläche „Aktivieren“ über dem Journal."

msgctxt "registrar.journal_activation"
msgid "Bu cədvəl dərsi bu gün artıq aktivləşdirilib."
msgstr ""
"Diese Unterrichtseinheit laut Stundenplan wurde heute bereits aktiviert."

msgctxt "registrar.journal_activation"
msgid "Dərs aktivləşdirildi: %(time)s · %(kind)s%(topic)s."
msgstr "Unterrichtseinheit aktiviert: %(time)s · %(kind)s%(topic)s."

msgctxt "registrar.journal_activation"
msgid "Bu günün cədvəl dərsləri"
msgstr "Heutiger Stundenplan"

msgctxt "registrar.journal_activation"
msgid ""
"Dərsi bir kliklə açın — saat, növ, otaq və növbəti mövzu cədvəldən və "
"sillabusdan götürülür."
msgstr ""
