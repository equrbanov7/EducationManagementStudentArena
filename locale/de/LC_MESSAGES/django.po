msgid "Defolt dəst"
msgstr "Standardsatz"

msgctxt "surveys.builder"
msgid "Anonim"
msgstr "Anonym"

msgctxt "surveys.builder"
msgid "Məcburi"
msgstr "Pflichtfach"

msgctxt "surveys.builder"
msgid "Auditoriya"
msgstr "Zielgruppe"

msgctxt "surveys.builder"
msgid "Jurnalı bağlanmış fənlərin tələbələri"
msgstr "Studierende von Fächern mit geschlossenem Journal"

msgctxt "surveys.builder"
msgid "Kampaniyalar"
msgstr "Kampagnen"

msgctxt "surveys.builder"
msgid "daraldılıb"
msgstr "eingeschränkt"

msgctxt "surveys.builder"
msgid "Açılış"
msgstr "Öffnung"

msgctxt "surveys.builder"
msgid "Bağlanma"
msgstr "Schließung"

msgctxt "surveys.builder"
msgid "Dolduran"
msgstr "Ausgefüllt"

msgctxt "surveys.builder"
