msgctxt "registrar.journal_exempt"
msgid ""
"Bu semestrdə jurnalı aktiv fənniniz yoxdur — qeydiyyatda olduğunuz fənlərdən"
" azad edilmisiniz. Qrupunuz dəyişmir."
msgstr ""
"In diesem Semester haben Sie keine Fächer mit aktivem Journal — Sie sind von"
" den Fächern befreit, für die Sie angemeldet waren. Ihre Gruppe ändert sich "
"nicht."

msgctxt "profile.subjects"
msgid "Bu semestrdə aktiv fənniniz yoxdur."
msgstr "In diesem Semester haben Sie keine aktiven Fächer."

msgctxt "profile.subjects"
msgid ""
