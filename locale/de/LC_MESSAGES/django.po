msgctxt "registrar.journal_history"
msgid "Dərs sütunu"
msgstr "Unterrichtsspalte"

msgctxt "registrar.journal_history"
msgid "başqasının adından · əsl aktor"
msgstr "im Namen eines anderen Benutzers · tatsächlich ausführende Person"

msgctxt "registrar.journal_history"
msgid "sətir daha göstər"
msgstr "weitere Zeilen"

msgctxt "registrar.journal_history"
msgid "Yığ"
msgstr "Einklappen"

msgctxt "registrar.journal_history"
msgid "sətir paneldə göstərilmir — bu saxlama çox böyükdür"
msgstr ""
