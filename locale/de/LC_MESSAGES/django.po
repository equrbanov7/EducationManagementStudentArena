msgstr "Nur aus dem Universitätsnetz"

msgctxt "accounts.network_zone"
msgid "Şəbəkə məhdudiyyəti"
msgstr "Netzwerkbeschränkung"

msgctxt "accounts.network_zone"
msgid "Elektron jurnal yalnız universitet şəbəkəsində açılır"
msgstr "Das elektronische Journal öffnet sich nur im Universitätsnetz"

