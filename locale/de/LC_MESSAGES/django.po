msgctxt "accounts.schedule_manage"
msgid "Dərsi cədvəldən çıxar"
msgstr "Unterrichtsstunde aus dem Stundenplan entfernen"

msgctxt "accounts.schedule_manage"
msgid "Toqquşma yoxdur — dərs bu xanaya qoyula bilər."
msgstr ""
"Keine Kollision — die Unterrichtsstunde kann in diese Zelle eingetragen "
"werden."

