"umfangreich"

msgctxt "registrar.journal_history"
msgid "qeyd göstərilir"
msgstr "Einträge angezeigt"

msgctxt "registrar.journal_history"
msgid "qeyd"
msgstr "Einträge"

msgctxt "registrar.journal_history"
