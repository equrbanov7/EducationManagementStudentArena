msgstr "Nach Name oder Benutzername suchen"

msgctxt "accounts.groups"
msgid "Akademik məzuniyyət"
msgstr "Urlaubssemester"

msgctxt "accounts.groups"
msgid ""
"Aktiv qeydiyyatlı tələbələr. Hər əməl səbəb və təsdiq tələb edir; tarixçə "
"silinmir."
msgstr ""
"Aktiv eingeschriebene Studierende. Jede Aktion erfordert eine Begründung und"
" eine Bestätigung; der Verlauf wird nie gelöscht."

msgctxt "accounts.groups"
msgid "Axtarışa uyğun tələbə tapılmadı."
msgstr "Keine Studierenden entsprechen der Suche."

msgctxt "accounts.groups"
msgid "Bu qrupda aktiv tələbə yoxdur."
msgstr "In dieser Gruppe gibt es keine aktiven Studierenden."

msgctxt "accounts.groups"
msgid ""
"Bu tarixə qədər tələbənin statusu «akademik məzuniyyət» olur; bərpa ayrıca "
"əməldir."
msgstr ""
"Bis zu diesem Datum hat der Studierende den Status „Beurlaubung“; die "
"Wiederaufnahme ist eine separate Aktion."

msgctxt "accounts.groups"
msgid "Dondur"
msgstr "Beurlauben"

msgctxt "accounts.groups"
msgid "Fərdi plan (DOCX)"
msgstr "Individueller Plan (DOCX)"

msgctxt "accounts.groups"
msgid "Fərdi tədris planı (DOCX) — bütöv qrup"
msgstr "Individueller Studienplan (DOCX) — ganze Gruppe"

msgctxt "accounts.groups"
