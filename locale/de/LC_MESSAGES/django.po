msgid_plural "Kim görəcək: %(who)s · %(where)s — təxminən %(n)s nəfər"
msgstr[0] "Wer sieht sie: %(who)s · %(where)s – etwa %(n)s Person"
msgstr[1] "Wer sieht sie: %(who)s · %(where)s – etwa %(n)s Personen"

msgctxt "exams.final_center.device"
msgid ""
"Bu final imtahanı başqa cihazda davam edir. Cihazı dəyişmək lazımdırsa, "
"nəzarətçidən və ya imtahan mərkəzindən «cihaz dəyişikliyi» təsdiqi istəyin, "
"sonra səhifəni yeniləyin."
msgstr ""
"Diese Abschlussprüfung wird auf einem anderen Gerät fortgesetzt. Wenn Sie "
"das Gerät wechseln müssen, bitten Sie die Aufsichtsperson oder das "
"Prüfungszentrum um die Freigabe „Gerätewechsel“ und laden Sie dann die Seite"
" neu."

msgctxt "exams.final_center.device"
msgid "İmtahan başqa cihazda davam edir"
msgstr "Die Prüfung wird auf einem anderen Gerät fortgesetzt"

msgctxt "exams.final_center.device"
msgid "Final imtahanı"
msgstr "Abschlussprüfung"

msgctxt "exams.final_center.device"
msgid ""
"Cavablarınız serverdə saxlanılıb — təsdiqdən sonra imtahan qaldığı yerdən "
"davam edəcək."
msgstr ""
"Ihre Antworten sind auf dem Server gespeichert – nach der Freigabe wird die "
"Prüfung dort fortgesetzt, wo Sie aufgehört haben."

msgctxt "exams.final_center.device"
msgid "Nəzarətçi təsdiqi"
msgstr "Freigabe durch die Aufsichtsperson"

msgctxt "exams.final_center.device"
msgid "Səhifəni yenilə"
msgstr "Seite neu laden"

msgctxt "exams.final_center.device"
msgid ""
"Hər cihaz dəyişikliyi nəzarətçi tərəfindən təsdiqlənir və jurnalda qeyd "
"olunur."
msgstr ""
"Jeder Gerätewechsel wird von einer Aufsichtsperson freigegeben und im Audit-"
"Protokoll erfasst."

msgctxt "exams.final_center.device"
msgid ""
"Cihaz dəyişikliyini yalnız nəzarətçi və ya imtahan mərkəzi təsdiqləyə bilər."
msgstr ""
"Nur eine Aufsichtsperson oder das Prüfungszentrum kann einen Gerätewechsel "
"freigeben."

msgctxt "exams.final_center.device"
msgid "Tələbənin davam edən final cəhdi yoxdur."
msgstr "Der Student hat keinen laufenden Abschlussprüfungsversuch."

#, python-format
msgctxt "exams.final_center.device"
msgid ""
"Cihaz dəyişikliyinə icazə verildi — tələbə %(minutes)d dəqiqə ərzində yeni "
"cihazdan davam edə bilər."
msgstr ""
"Gerätewechsel freigegeben – der Student kann innerhalb von %(minutes)d "
"Minuten auf einem neuen Gerät fortfahren."

msgctxt "exams.final_center.device"
msgid ""
"Cəhd hələ heç bir cihaza bağlanmayıb — tələbə ilk açdığı cihazdan davam "
"edəcək."
msgstr ""
"Der Versuch ist noch an kein Gerät gebunden – der Student setzt auf dem "
"ersten Gerät fort, auf dem er ihn öffnet."

msgctxt "exams.final_center.device"
msgid "Cihaz dəyişikliyinə icazə ver"
msgstr "Gerätewechsel freigeben"

msgctxt "exams.final_center.device"
msgid "Cihaz dəyişikliyi təsdiqlənib — tələbə yeni cihazdan daxil olmalıdır"
msgstr ""
"Gerätewechsel freigegeben – der Student muss sich auf dem neuen Gerät "
"anmelden"

msgctxt "exams.final_center.device"
msgid "Təsdiq alınmadı — yenidən cəhd edin."
msgstr "Freigabe fehlgeschlagen – bitte versuchen Sie es erneut."

msgctxt "exams.model.final_device.meta"
msgid "singular"
msgstr "Gerät des Abschlussprüfungsversuchs"

msgctxt "exams.model.final_device.meta"
msgid "plural"
msgstr "Geräte der Abschlussprüfungsversuche"

msgctxt "syllabus.model"
msgid "Bağlı sillabusdan (eyni məzmun)"
msgstr "Aus einem verknüpften Syllabus (gleicher Inhalt)"

msgctxt "syllabus.model"
msgid "Başqa qrupun sillabusuna bağlanıb"
msgstr "Mit dem Syllabus einer anderen Gruppe verknüpft"

msgctxt "syllabus.document"
msgid "Təsdiq: %(group)s sillabusundan (eyni məzmun, eyni saatlar)"
msgstr ""
"Genehmigung: aus dem Syllabus von %(group)s (gleicher Inhalt, gleiche "
"Stunden)"

msgctxt "syllabus.document"
msgid "Təsdiq: bağlı sillabusdan (eyni məzmun, eyni saatlar)"
msgstr ""
"Genehmigung: aus einem verknüpften Syllabus (gleicher Inhalt, gleiche "
"Stunden)"

msgctxt "accounts.syllabus"
msgid ""
"%(count)s bağlı sillabus hələ köhnə versiyadadır. Yeni versiya təsdiqlənəndə"
" onlar özbaşına dəyişmir — «Bağlı sillabuslara tətbiq et» ilə yeniləyin."
msgstr ""
"%(count)s verknüpfte Syllabi sind noch auf einer älteren Version. Sie ändern"
" sich nicht automatisch, wenn eine neue Version genehmigt wird – "
"aktualisieren Sie sie mit „Auf verknüpfte Syllabi anwenden“."

msgctxt "accounts.syllabus"
msgid "%(count)s bağlı sillabus köhnə versiyadadır"
msgstr "%(count)s verknüpfte Syllabi sind auf einer älteren Version"

msgctxt "accounts.syllabus"
msgid "%(count)s qrup bu sillabusa bağlıdır"
msgstr "%(count)s Gruppen sind mit diesem Syllabus verknüpft"

msgctxt "accounts.syllabus"
msgid "Ayır"
msgstr "Verknüpfung lösen"

msgctxt "accounts.syllabus"
msgid "Ayır və qaralama aç"
msgstr "Verknüpfung lösen und Entwurf öffnen"

msgctxt "accounts.syllabus"
msgid ""
"Bağ ayrıldı — redaktə üçün müstəqil qaralama açıldı. Təsdiqlənmiş nüsxə "
"qüvvədə qalır."
msgstr ""
"Verknüpfung gelöst – ein unabhängiger Entwurf ist zur Bearbeitung geöffnet. "
"Die genehmigte Fassung bleibt in Kraft."

msgctxt "accounts.syllabus"
msgid "Bağ ayrılsın?"
msgstr "Verknüpfung dieses Syllabus lösen?"

msgctxt "accounts.syllabus"
msgid ""
"Bağlamaq yalnız öz sillabusunuza mümkündür — başqasının sillabusunu "
"kopyalaya bilərsiniz."
msgstr ""
"Sie können nur mit Ihrem eigenen Syllabus verknüpfen – den Syllabus einer "
"anderen Person können Sie kopieren."

msgctxt "accounts.syllabus"
msgid "Bağlandı: %(linked)s · kopyalandı: %(copied)s · ötürüldü: %(skipped)s."
msgstr ""
"Verknüpft: %(linked)s · kopiert: %(copied)s · übersprungen: %(skipped)s."

msgctxt "accounts.syllabus"
msgid ""
"Bağlı qruplar bu sillabusun son təsdiqlənmiş versiyasını görür. Yeni versiya"
" təsdiqlənəndə onlar özbaşına dəyişmir — tətbiq etmək sizin qərarınızdır."
msgstr ""
"Verknüpfte Gruppen sehen die neueste genehmigte Version dieses Syllabus. Sie"
" ändern sich nicht automatisch, wenn eine neue Version genehmigt wird – die "
"Anwendung ist Ihre Entscheidung."

msgctxt "accounts.syllabus"
msgid "Bağlı sillabus artıq mənbənin son təsdiqlənmiş versiyasındadır."
msgstr ""
"Der verknüpfte Syllabus ist bereits auf der neuesten genehmigten Version der"
" Quelle."

msgctxt "accounts.syllabus"
msgid "Bağlı sillabuslara tətbiq edilsin?"
msgstr "Auf verknüpfte Syllabi anwenden?"

msgctxt "accounts.syllabus"
msgid "Bağlı sillabuslara tətbiq et"
msgstr "Auf verknüpfte Syllabi anwenden"

msgctxt "accounts.syllabus"
msgid "Bağlıdır: %(group)s sillabusu"
msgstr "Verknüpft: Syllabus von %(group)s"

msgctxt "accounts.syllabus"
msgid "Boş qaralama yarat"
msgstr "Leeren Entwurf erstellen"

msgctxt "accounts.syllabus"
msgid "Bu fənn üzrə digər qruplarınız"
msgstr "Ihre anderen Gruppen in diesem Fach"

msgctxt "accounts.syllabus"
msgid "Bu fənnin bu semestr üçün artıq sillabusu var"
msgstr "Für dieses Fach gibt es in diesem Semester bereits einen Syllabus"

msgctxt "accounts.syllabus"
msgid ""
"Bu fənnin bu semestr üçün artıq sillabusu var — bağlaya və ya kopyalaya "
"bilərsiniz"
msgstr ""
"Für dieses Fach gibt es in diesem Semester bereits einen Syllabus – Sie "
"können ihn verknüpfen oder kopieren"

msgctxt "accounts.syllabus"
msgid ""
"Bu qrupun mövcud qaralamasının məzmunu mənbənin məzmunu ilə əvəzlənəcək "
"(əvvəlki mətn audit izində saxlanılır)."
msgstr ""
"Der aktuelle Entwurf dieser Gruppe wird durch den Inhalt der Quelle ersetzt "
"(der bisherige Text bleibt im Audit-Protokoll erhalten)."

msgctxt "accounts.syllabus"
msgid ""
"Bu qrupun saat bölgüsü məlum deyil — bağlamaq üçün saatlar eyni olmalıdır."
msgstr ""
"Die Stundenaufteilung dieser Gruppe ist unbekannt – für eine Verknüpfung "
"müssen die Stunden identisch sein."

msgctxt "accounts.syllabus"
msgid "Bu qrupun sillabusu artıq bağlıdır."
msgstr "Der Syllabus dieser Gruppe ist bereits verknüpft."

msgctxt "accounts.syllabus"
msgid ""
"Bu qrupun sillabusu artıq göndərilib və ya təsdiqlənib — üstünə yazmaq "
"olmaz."
msgstr ""
"Der Syllabus dieser Gruppe wurde bereits eingereicht oder genehmigt – er "
"kann nicht überschrieben werden."

msgctxt "accounts.syllabus"
msgid "Bu sillabus %(group)s sillabusuna bağlıdır"
msgstr "Dieser Syllabus ist mit dem Syllabus von %(group)s verknüpft"

msgctxt "accounts.syllabus"
msgid ""
"Bu sillabus başqa qrupun sillabusuna bağlıdır — dəyişiklik üçün əvvəlcə "
"«Ayır» düyməsini basın."
msgstr ""
"Dieser Syllabus ist mit dem Syllabus einer anderen Gruppe verknüpft – um ihn"
" zu ändern, klicken Sie zuerst auf „Verknüpfung lösen“."

msgctxt "accounts.syllabus"
msgid "Bu sillabus heç bir sillabusa bağlı deyil."
msgstr "Dieser Syllabus ist mit keinem Syllabus verknüpft."

msgctxt "accounts.syllabus"
msgid "Bu sillabusa bağlı qrup sayı: %(count)s"
msgstr "Mit diesem Syllabus verknüpfte Gruppen: %(count)s"

msgctxt "accounts.syllabus"
msgid "Bu sillabusu kopyalamaq üçün icazəniz yoxdur."
msgstr "Sie sind nicht berechtigt, diesen Syllabus zu kopieren."

msgctxt "accounts.syllabus"
msgid ""
"Bu sillabusun son təsdiqlənmiş versiyası ona bağlı bütün qruplara tətbiq "
"olunacaq. Saatı dəyişmiş və ya öz qaralaması açıq olan qrup ötürülür."
msgstr ""
"Die neueste genehmigte Version dieses Syllabus wird auf alle verknüpften "
"Gruppen angewendet. Gruppen mit geänderten Stunden oder einem eigenen "
"offenen Entwurf werden übersprungen."

msgctxt "accounts.syllabus"
msgid "Eyni sillabusu istifadə et (bağla)"
msgstr "Denselben Syllabus verwenden (verknüpfen)"

msgctxt "accounts.syllabus"
msgid "Göstər"
msgstr "Anzeigen"

msgctxt "accounts.syllabus"
msgid "Hamısına tətbiq et"
msgstr "Auf alle anwenden"

msgctxt "accounts.syllabus"
msgid "Hazırdır"
msgstr "Fertig"

msgctxt "accounts.syllabus"
msgid "Kopyala və uyğunlaşdır"
msgstr "Kopieren und anpassen"

msgctxt "accounts.syllabus"
msgid "Mənim fənlərim"
msgstr "Meine Fächer"

msgctxt "accounts.syllabus"
msgid "Bu fənn üzrə köçürə biləcəyiniz keçmiş sillabus tapılmadı."
msgstr ""
"Für dieses Fach ist kein früherer Syllabus vorhanden, den Sie kopieren "
"können."

msgctxt "accounts.syllabus"
msgid "Bu fənn üçün keçmiş semestrlərin sillabusu var"
msgstr "Für dieses Fach gibt es Syllabi aus früheren Semestern"

msgctxt "accounts.syllabus"
msgid ""
"Keçmiş semestrin məzmunu qaralama kimi köçürülür, həftəlik plan bu qrupun "
"saatına uyğunlaşdırılır, sonra adi qaydada təsdiqə göndərilir."
msgstr ""
"Der Inhalt des früheren Semesters wird als Entwurf kopiert, der Wochenplan "
"wird an die Stunden dieser Gruppe angepasst und anschließend wie üblich zur "
"Genehmigung eingereicht."

msgctxt "accounts.syllabus"
msgid ""
"Keçmiş semestrin sillabusu köçürüldü və bu qrupun saatına uyğunlaşdırıldı — "
"QARALAMA açıldı."
msgstr ""
"Der Syllabus des früheren Semesters wurde kopiert und an die Stunden dieser "
"Gruppe angepasst – ein ENTWURF ist geöffnet."

msgctxt "accounts.syllabus"
msgid "Keçmiş semestrin sillabusundan köçür"
msgstr "Aus dem Syllabus eines früheren Semesters kopieren"

msgctxt "accounts.syllabus"
msgid ""
"Keçmiş sillabusu köçürüb bu qrupun saatına uyğunlaşdıra bilərsiniz — nəticə "
"qaralamadır və adi qaydada təsdiqə göndərilir."
msgstr ""
"Sie können den früheren Syllabus kopieren und an die Stunden dieser Gruppe "
"anpassen – das Ergebnis ist ein Entwurf und durchläuft die übliche "
"Genehmigung."

msgctxt "accounts.syllabus"
msgid "Mənbə bu fənnin başqa semestrinə aid deyil."
msgstr "Die Quelle gehört nicht zu einem anderen Semester dieses Fachs."

msgctxt "accounts.syllabus"
msgid "Semestrsiz baza sillabus"
msgstr "Basis-Syllabus (ohne Semester)"

msgctxt "accounts.syllabus"
msgid "Mövcud sillabusdan istifadə et"
msgstr "Vorhandenen Syllabus verwenden"

msgctxt "accounts.syllabus"
msgid "Mənbə eyni fənnin eyni semestrinə aid deyil."
msgstr "Die Quelle gehört nicht zum selben Fach und Semester."

msgctxt "accounts.syllabus"
msgid "Mənbə sillabus"
msgstr "Quell-Syllabus"

msgctxt "accounts.syllabus"
msgid ""
"Mənbə sillabus hələ təsdiqlənməyib — bağlamaq təsdiqdən sonra mümkündür, "
"indi kopyalaya bilərsiniz."
msgstr ""
"Der Quell-Syllabus ist noch nicht genehmigt – eine Verknüpfung ist nach der "
"Genehmigung möglich; kopieren können Sie ihn jetzt."

msgctxt "accounts.syllabus"
msgid "Mənbədə yeni təsdiqlənmiş versiya var"
msgstr "Die Quelle hat eine neuere genehmigte Version"

msgctxt "accounts.syllabus"
msgid "Mənbədə yeni təsdiqlənmiş versiya var."
msgstr "Die Quelle hat eine neuere genehmigte Version."

msgctxt "accounts.syllabus"
msgid ""
"Mənbədə yeni təsdiqlənmiş versiya var. Saatlar eyni qaldığı üçün eyni məzmun"
" bu qrupa da tətbiq olunacaq; əvvəlki nüsxə arxivlənir."
msgstr ""
"Die Quelle hat eine neuere genehmigte Version. Da die Stunden noch gleich "
"sind, wird derselbe Inhalt auf diese Gruppe angewendet; die bisherige "
"Fassung wird archiviert."

msgctxt "accounts.syllabus"
msgid "Mənbədən yenilə"
msgstr "Aus der Quelle aktualisieren"

msgctxt "accounts.syllabus"
msgid "Mənbənin son təsdiqlənmiş versiyası bu sillabusa tətbiq olundu."
msgstr ""
"Die neueste genehmigte Version der Quelle wurde auf diesen Syllabus "
"angewendet."

msgctxt "accounts.syllabus"
msgid ""
"Mənbənin təsdiqi kafedra qərarı deyil (köçürmə və ya bağlama) — yalnız "
"kopyalamaq olar."
msgstr ""
"Die Genehmigung der Quelle ist keine Entscheidung des Lehrstuhls (Migration "
"oder Verknüpfung) – sie kann nur kopiert werden."

msgctxt "accounts.syllabus"
msgid "Mənbənin yeni versiyası tətbiq olunsun?"
msgstr "Neue Version der Quelle anwenden?"

msgctxt "accounts.syllabus"
msgid ""
"Məzmun kopyalandı və saatlara uyğunlaşdırıldı — qaralamanı yoxlayıb təsdiqə "
"göndərin."
msgstr ""
"Inhalt kopiert und an die Stunden angepasst – prüfen Sie den Entwurf und "
"reichen Sie ihn zur Genehmigung ein."

msgctxt "accounts.syllabus"
msgid ""
"Məzmun qaralama kimi kopyalanır, həftəlik plan bu qrupun saatına "
"uyğunlaşdırılır, sonra adi qaydada təsdiqə göndərilir."
msgstr ""
"Der Inhalt wird als Entwurf kopiert, der Wochenplan wird an die Stunden "
"dieser Gruppe angepasst und anschließend wie üblich zur Genehmigung "
"eingereicht."

msgctxt "accounts.syllabus"
msgid ""
"Məzmun və saatlar mənbə ilə eynidir; təsdiq mənbənin kafedra təsdiqindən "
"gəlir. Dəyişiklik etmək üçün bağı ayırın — müstəqil qaralama açılacaq."
msgstr ""
"Inhalt und Stunden sind mit der Quelle identisch; die Genehmigung ergibt "
"sich aus der Lehrstuhlgenehmigung der Quelle. Um Änderungen vorzunehmen, "
"lösen Sie die Verknüpfung – ein unabhängiger Entwurf wird geöffnet."

msgctxt "accounts.syllabus"
msgid "Saatlar eynidir"
msgstr "Gleiche Stunden"

msgctxt "accounts.syllabus"
msgid ""
"Saatlar eynidir — eyni təsdiqlənmiş məzmun bu qrup üçün də qüvvəyə minir, "
"ayrıca təsdiq lazım deyil."
msgstr ""
"Gleiche Stunden – derselbe genehmigte Inhalt gilt auch für diese Gruppe; "
"eine gesonderte Genehmigung ist nicht nötig."

msgctxt "accounts.syllabus"
msgid "Saatlar fərqlidir"
msgstr "Abweichende Stunden"

msgctxt "accounts.syllabus"
msgid "Saatlar fərqlidir — kopyalayıb həftəlik planı uyğunlaşdırın."
msgstr ""
"Die Stunden weichen ab – kopieren Sie ihn und passen Sie den Wochenplan an."

msgctxt "accounts.syllabus"
msgid "Semestr dosyesi"
msgstr "Semesterakte"

msgctxt "accounts.syllabus"
msgid ""
"Seçilmiş qruplara eyni mənbə tətbiq olunur: saatlar eynidirsə bağlanır, "
"fərqlidirsə kopyalanıb uyğunlaşdırılır. Sillabusu olan qrup dəyişdirilmir."
msgstr ""
"Dieselbe Quelle wird auf die ausgewählten Gruppen angewendet: verknüpft, "
"wenn die Stunden übereinstimmen, andernfalls kopiert und angepasst. Gruppen,"
" die bereits einen Syllabus haben, werden nicht geändert."

msgctxt "accounts.syllabus"
msgid ""
"Sillabus bağlandı — %(group)s qrupunun təsdiqlənmiş sillabusu ilə eyni "
"məzmun qüvvəyə mindi."
msgstr ""
"Syllabus verknüpft – derselbe Inhalt wie im genehmigten Syllabus von "
"%(group)s ist jetzt in Kraft."

msgctxt "accounts.syllabus"
msgid ""
"Sillabuslar fərqli kafedraların təsdiqinə düşür — kopyalayıb ayrıca təsdiqə "
"göndərin."
msgstr ""
"Die Syllabi unterliegen der Genehmigung verschiedener Lehrstühle – kopieren "
"Sie ihn und reichen Sie ihn gesondert ein."

msgctxt "accounts.syllabus"
msgid "Müəllif: siz"
msgstr "Autor: Sie"

msgctxt "accounts.syllabus"
msgid "Sizin üçün uyğun mənbə sillabus tapılmadı."
msgstr "Für Sie wurde kein passender Quell-Syllabus gefunden."

msgctxt "accounts.syllabus"
msgid ""
"Sıfırdan yazmaq lazım deyil: saatlar eynidirsə təsdiqlənmiş sillabusa "
"bağlayın, fərqlidirsə kopyalayıb bu qrupun saatına uyğunlaşdırın."
msgstr ""
"Sie müssen nicht bei null anfangen: Verknüpfen Sie mit dem genehmigten "
"Syllabus, wenn die Stunden übereinstimmen, andernfalls kopieren Sie ihn und "
"passen ihn an die Stunden dieser Gruppe an."

msgctxt "accounts.syllabus"
msgid ""
"Təsdiqlənmiş nüsxə tələbələr üçün qüvvədə qalır. Redaktə üçün müstəqil "
"qaralama açılır və o, adi qaydada kafedra təsdiqinə göndərilir. Mənbədəki "
"sonrakı dəyişikliklər bu qrupa artıq tətbiq olunmayacaq."
msgstr ""
"Die genehmigte Fassung bleibt für Studierende in Kraft. Ein unabhängiger "
"Entwurf wird zur Bearbeitung geöffnet und durchläuft die übliche "
"Lehrstuhlgenehmigung. Spätere Änderungen an der Quelle gelten nicht mehr für"
" diese Gruppe."

msgctxt "accounts.syllabus"
msgid "Tətbiq et"
msgstr "Anwenden"

msgctxt "accounts.syllabus"
msgid ""
"Yeniləndi: %(synced)s · artıq son versiyada: %(already)s · ötürüldü: "
"%(skipped)s."
msgstr ""
"Aktualisiert: %(synced)s · bereits aktuell: %(already)s · übersprungen: "
"%(skipped)s."

msgctxt "accounts.syllabus"
msgid "artıq bağlı idi"
msgstr "war bereits verknüpft"

msgctxt "accounts.syllabus"
msgid "artıq bağlıdır"
msgstr "bereits verknüpft"

msgctxt "accounts.syllabus"
msgid "bağlanacaq"
msgstr "wird verknüpft"

msgctxt "accounts.syllabus"
msgid "bağlandı"
msgstr "verknüpft"

msgctxt "accounts.syllabus"
msgid "bağlı qrup: {count}"
msgstr "verknüpfte Gruppen: {count}"

msgctxt "accounts.syllabus"
msgid "kopyalanacaq"
msgstr "wird kopiert"

msgctxt "accounts.syllabus"
msgid "kopyalandı"
msgstr "kopiert"

msgctxt "accounts.syllabus"
msgid "saat məlum deyil"
msgstr "Stunden unbekannt"

msgctxt "accounts.syllabus"
msgid "sillabus yoxdur"
msgstr "kein Syllabus"

msgctxt "accounts.syllabus"
msgid "yeniləndi"
msgstr "aktualisiert"

msgctxt "accounts.syllabus"
msgid "ötürüldü"
msgstr "übersprungen"

msgctxt "accounts.syllabus"
msgid "öz sillabusu var"
msgstr "hat eigenen Syllabus"

msgctxt "accounts.syllabus"
msgid "öz sillabusu var — dəyişdirilmədi"
msgstr "hat eigenen Syllabus – nicht geändert"

msgctxt "live_exam.host_controls"
msgid "Hər sual üçün vaxt"
msgstr "Zeit pro Frage"

msgctxt "live_exam.host_controls"
msgid "Standart · {seconds} san"
msgstr "Standard · {seconds} s"

msgctxt "live_exam.host_controls"
msgid "{seconds} san"
msgstr "{seconds} s"

msgctxt "live_exam.host_controls"
msgid "Digər ({min}–{max} san)"
msgstr "Benutzerdefiniert ({min}–{max} s)"

msgctxt "live_exam.host_controls"
msgid "Tətbiq et"
msgstr "Anwenden"

msgctxt "live_exam.host_controls"
msgid "Dəyişiklik növbəti sualdan tətbiq olunur."
msgstr "Die Änderung gilt ab der nächsten Frage."

msgctxt "live_exam.host_controls"
msgid "Hər sual bu qədər vaxt gedəcək."
msgstr "Jede Frage läuft so lange."

msgctxt "live_exam.host_controls"
msgid "Standart: sualın öz vaxtı, yoxdursa imtahanın vaxtı."
msgstr ""
"Standard: die eigene Zeit der Frage, andernfalls die Zeit der Prüfung."

msgctxt "live_exam.host_controls"
msgid "{min}–{max} saniyə arası rəqəm yazın"
msgstr "Geben Sie eine Zahl zwischen {min} und {max} Sekunden ein"

msgctxt "live_exam.host_controls"
msgid "Vaxt saxlanmadı. Yenidən cəhd edin."
msgstr "Die Zeit wurde nicht gespeichert. Bitte versuchen Sie es erneut."

msgctxt "live_exam.host_controls"
msgid "Hər sual üçün vaxt: {value}"
msgstr "Zeit pro Frage: {value}"

msgctxt "live_exam.host_settings"
msgid "Sual vaxtı 5–300 saniyə olmalıdır."
msgstr "Die Fragezeit muss 5–300 Sekunden betragen."

msgctxt "live_exam.host_controls"
msgid "Gecikənlər bu PIN ilə qoşula bilər"
msgstr "Nachzügler können mit dieser PIN beitreten"

msgctxt "live_exam.view.message"
msgid "Oyun artıq başlayıb və müəllim gecikənlərin qoşulmasını bağlayıb."
msgstr ""
"Das Spiel hat bereits begonnen und die Lehrkraft hat den verspäteten "
"Beitritt deaktiviert."

msgctxt "live_exam.consumer.error"
msgid "Növbəti sual başlayanda oyuna qoşulacaqsan."
msgstr "Sie treten dem Spiel bei, sobald die nächste Frage beginnt."

msgctxt "live_exam.player"
msgid "Oyuna qoşuldun!"
msgstr "Sie sind dabei!"

msgctxt "live_exam.player"
msgid ""
"Oyun artıq gedir — növbəti sual başlayanda daxil olacaqsan. Keçən suallar "
"üçün bal verilmir."
msgstr ""
"Das Spiel läuft bereits – Sie steigen ein, sobald die nächste Frage beginnt."
" Für verpasste Fragen gibt es keine Punkte."

msgctxt "live_exam.host_settings"
msgid "Gecikənlər qoşula bilsin"
msgstr "Verspäteten Beitritt erlauben"

msgctxt "live_exam.host_settings"
msgid "Tövsiyə olunur"
msgstr "Empfohlen"

msgctxt "live_exam.host_settings"
msgid ""
"Oyun başlayandan sonra gələn tələbə növbəti sualdan qoşulur: keçən suallara "
"bal almır və onların cavablarını görmür. Kilidli lobbi, iştirakçı limiti və "
"çıxarılanlar qaydası qüvvədədir."
msgstr ""
"Ein Student, der nach dem Start kommt, steigt ab der nächsten Frage ein: "
"keine Punkte für verpasste Fragen, und deren Antworten werden nicht "
"angezeigt. Gesperrter Warteraum, Teilnehmerlimit und Entfernungen gelten "
"weiterhin."

msgctxt "live_exam.host_controls"
msgid "Oyun idarəsi"
msgstr "Spielsteuerung"

msgctxt "live_exam.host_controls"
msgid "İştirakçılar"
msgstr "Teilnehmer"

msgctxt "live_exam.host_controls"
msgid "Bağla"
msgstr "Schließen"

msgctxt "live_exam.host_controls"
msgid "Ad üzrə axtar…"
msgstr "Nach Name suchen…"

msgctxt "live_exam.host_controls"
msgid ""
"Çıxarılan iştirakçı bu oyuna həmin cihazla qayıda bilməz, balı liderlər "
"lövhəsində göstərilmir; nəticədə «Çıxarıldı» kimi qalır."
msgstr ""
"Ein entfernter Teilnehmer kann mit demselben Gerät nicht zu diesem Spiel "
"zurückkehren, und seine Punktzahl wird in der Bestenliste ausgeblendet; in "
"den Ergebnissen bleibt er als „Entfernt“ erhalten."

msgctxt "live_exam.host_controls"
msgid "Ləğv et"
msgstr "Abbrechen"

msgctxt "live_exam.host_controls"
msgid "Çıxar"
msgstr "Entfernen"

msgctxt "live_exam.host_controls"
msgid "Növbəti sualdan"
msgstr "Ab der nächsten Frage"

msgctxt "live_exam.host_controls"
msgid "Uyğun iştirakçı yoxdur"
msgstr "Keine passenden Teilnehmer"

msgctxt "live_exam.host_controls"
msgid "Hələ heç kim qoşulmayıb"
msgstr "Noch niemand beigetreten"

msgctxt "live_exam.host_controls"
msgid "«{name}» oyundan çıxarılsın?"
msgstr "„{name}“ aus dem Spiel entfernen?"

msgctxt "live_exam.host_controls"
msgid ""
"Telefonu oyundan çıxacaq, bu cihazla geri qayıda bilməyəcək. Balı liderlər "
"lövhəsində göstərilməyəcək."
msgstr ""
"Das Telefon verlässt das Spiel und kann mit diesem Gerät nicht zurückkehren."
" Die Punktzahl wird in der Bestenliste nicht angezeigt."

msgctxt "live_exam.host_controls"
msgid "Telefonu lobbidən çıxacaq və bu cihazla geri qayıda bilməyəcək."
msgstr ""
"Das Telefon verlässt den Warteraum und kann mit diesem Gerät nicht "
"zurückkehren."

msgctxt "live_exam.host_controls"
msgid "«{name}» oyundan çıxarıldı"
msgstr "„{name}“ wurde aus dem Spiel entfernt"

msgctxt "live_exam.host_controls"
msgid "Çıxarmaq alınmadı. Yenidən cəhd edin."
msgstr ""
"Der Teilnehmer konnte nicht entfernt werden. Bitte versuchen Sie es erneut."

msgctxt "liveExam.template.session_detail"
msgid "Çıxarıldı"
msgstr "Entfernt"

msgctxt "live_exam.view.message"
msgid "İştirakçını oyun bitənə qədər çıxarmaq olar."
msgstr "Ein Teilnehmer kann nur vor Spielende entfernt werden."

msgctxt "live_exam.view.message"
msgid "İştirakçı tapılmadı."
msgstr "Teilnehmer nicht gefunden."

msgctxt "live_exam.host_controls"
msgid "Hamısını görmək üçün siyahını sürüşdürün"
msgstr "Scrollen Sie die Liste, um alle zu sehen"

msgctxt "live_exam.view.message"
msgid "Çox sayda cəhd edildi. Zəhmət olmasa bir az sonra yenidən cəhd edin."
msgstr "Zu viele Versuche. Bitte versuchen Sie es etwas später erneut."

msgctxt "live_exam.view.message"
msgid ""
"Çox sayda sorğu göndərildi. Zəhmət olmasa bir az sonra yenidən cəhd edin."
msgstr "Zu viele Anfragen. Bitte versuchen Sie es etwas später erneut."

msgctxt "live_exam.pin_entry"
msgid "Canlı imtahana qoşul"
msgstr "An einer Live-Prüfung teilnehmen"

msgctxt "live_exam.pin_entry"
msgid "Canlı"
msgstr "Live"

msgctxt "live_exam.pin_entry"
msgid "Müəllimin göstərdiyi PIN-i yaz, sonra adını seçib oyuna daxil ol."
msgstr ""
"Geben Sie die von der Lehrkraft angezeigte PIN ein, wählen Sie dann Ihren "
"Namen und treten Sie dem Spiel bei."

msgctxt "live_exam.pin_entry"
msgid "Oyun PIN-i"
msgstr "Spiel-PIN"

msgctxt "live_exam.pin_entry"
msgid "Məsələn: 3A8K2B94F1"
msgstr "Beispiel: 3A8K2B94F1"

msgctxt "live_exam.pin_entry"
msgid "Davam et"
msgstr "Weiter"

msgctxt "live_exam.pin_entry"
msgid ""
"PIN-i ekranda gördüyün kimi daxil et. Növbəti addımda ad və avatar "
"seçəcəksən."
msgstr ""
"Geben Sie die PIN genau so ein, wie sie auf dem Bildschirm steht. Im "
"nächsten Schritt wählen Sie Spitznamen und Avatar."

msgctxt "live_exam.pin_entry"
msgid "Saniyələr içində qoşul"
msgstr "In Sekunden beitreten"

msgctxt "live_exam.pin_entry"
msgid "Telefon, planşet və kompüterdən işləyir"
msgstr "Funktioniert auf Telefon, Tablet und Computer"

msgctxt "live_exam.pin_entry"
msgid "Canlı nəticə və liderlik cədvəli"
msgstr "Live-Ergebnisse und Bestenliste"

msgctxt "live_exam.pin_entry"
msgid "Hazırsan?"
msgstr "Bereit zum Spielen?"

msgctxt "live_exam.pin_entry"
msgid "Bir URL, bir PIN, hamısı eyni oyunda."
msgstr "Ein Link, eine PIN, alle in derselben Sitzung."

msgctxt "live_exam.pin_entry"
msgid "Müəllim ekranında PIN və QR kod görünür."
msgstr "Auf dem Bildschirm der Lehrkraft werden PIN und QR-Code angezeigt."

msgctxt "live_exam.pin_entry"
msgid "Daxil olduqdan sonra avatar və ad seçimi gəlir."
msgstr "Nach diesem Schritt wählen die Studierenden Spitznamen und Avatar."

msgctxt "live_exam.pin_entry"
msgid "Yoxlanılır..."
msgstr "Wird geprüft..."

msgctxt "live_exam.pin_entry"
msgid "Düzgün PIN daxil et."
msgstr "Geben Sie eine gültige PIN ein."

msgctxt "live_exam.pin_entry"
msgid "Bu PIN tapılmadı və ya oyun bağlanıb."
msgstr "Diese PIN wurde nicht gefunden oder die Sitzung ist geschlossen."

msgctxt "live_exam.join"
msgid "Əvvəlki qoşulma tapıldı"
msgstr "Früherer Beitritt gefunden"

msgctxt "live_exam.join"
msgid "{nickname} adı ilə bu oyuna artıq daxil olmusan."
msgstr "Sie sind diesem Spiel bereits als {nickname} beigetreten."

msgctxt "live_exam.join"
msgid ""
"İstəsən həmin oyunçu ilə davam et, istəsən yeni ad və avatarla yenidən "
"qoşul."
msgstr ""
"Fahren Sie mit diesem Teilnehmer fort oder treten Sie mit neuem Spitznamen "
"und Avatar erneut bei."

msgctxt "live_exam.join"
msgid "{nickname} kimi davam et"
msgstr "Als {nickname} fortfahren"

msgctxt "live_exam.join"
msgid "Əvvəlki adla davam etmək istəyirsən?"
msgstr "Mit Ihrem bisherigen Namen fortfahren?"

msgctxt "live_exam.join"
msgid ""
"Bu PIN üçün aktiv oyunçu profilin var. Həmin profil ilə gözləmə otağına "
"qayıda və ya yeni ad/avatar seçib yenidən daxil ola bilərsən."
msgstr ""
"Sie haben bereits ein aktives Teilnehmerprofil für diese PIN. Sie können in "
"den Warteraum zurückkehren oder mit neuem Spitznamen und Avatar erneut "
"beitreten."

msgctxt "live_exam.join"
msgid "Yenidən daxil ol"
msgstr "Erneut beitreten"

msgctxt "live_exam.join"
msgid "Bağla"
msgstr "Schließen"

msgctxt "live_exam.join"
msgid "Bu ad artıq istifadə olunur. Başqa ad seç."
msgstr "Dieser Spitzname wird bereits verwendet. Wählen Sie einen anderen."

msgctxt "core.datetime_input"
