msgstr "Der gezahlte Betrag ist nicht erfasst — Betrag eingeben."

msgctxt "registrar.retake"
msgid "(boş — ödənilənin hamısı)"
msgstr "(leer — der gesamte gezahlte Betrag)"

#, python-format
msgctxt "registrar.retake"
msgid "qaytarılıb: %(day)s, arayış № %(ref)s"
msgstr "erstattet: %(day)s, Beleg Nr. %(ref)s"

msgctxt "registrar.retake"
msgid "Əmr"
msgstr "Anordnung"

msgctxt "registrar.retake"
msgid "Qərar"
msgstr "Entscheidung"

msgctxt "registrar.retake"
msgid "Qərarı verib"
msgstr "Entschieden von"

msgctxt "registrar.retake"
msgid "Bank arayışı / ödəniş tapşırığı №"
msgstr "Bankbeleg / Zahlungsauftrag Nr."

msgctxt "registrar.retake"
msgid "Qaytarılma tarixi"
msgstr "Erstattungsdatum"

msgctxt "registrar.retake"
msgid "Qeyd geri alınmır — yalnız pul faktiki qaytarıldıqdan sonra təsdiqləyin."
msgstr "Der Eintrag ist endgültig — erst bestätigen, wenn das Geld tatsächlich erstattet wurde."

msgctxt "registrar.retake"
msgid "Sistem pul köçürmür: qərar qeyd olunur, Mühasibatlıq «Qaytarılacaq ödənişlər» növbəsində icranı «Qaytarıldı» ilə təsdiqləyir."
msgstr "Das System überweist kein Geld: Die Entscheidung wird erfasst, die Buchhaltung bestätigt die Ausführung in der Warteschlange „Offene Erstattungen“ mit „Erstattet“."

msgctxt "registrar.retake"
msgid "Defolt qaytarılma yoxdur — qaytarılma yalnız rəsmi qərarla: əmr nömrəsi və tarixi və ya qərar sənədi, səbəb məcburidir. Bir müraciətə bir dəfə."
msgstr "Standardmäßig gibt es keine Erstattung — nur per offizieller Entscheidung: Anordnungsnummer und -datum oder ein Entscheidungsdokument sowie eine Begründung sind Pflicht. Einmal pro Antrag."

msgctxt "registrar.retake"
msgid "Defolt qaytarılma yoxdur. Qaytarılma lazımdırsa, bağlanışdan sonra «Ödənişin qaytarılması qərarı» ilə ayrıca rəsmi qərar verilir (Tədris şöbəsi / RİM)."
msgstr "Standardmäßig gibt es keine Erstattung. Ist eine nötig, wird nach dem Abschluss eine eigene offizielle „Erstattungsentscheidung“ erlassen (Studienbüro / IT-Leitung)."

msgctxt "registrar.retake"
msgid "Bank arayışı və ya ödəniş tapşırığı nömrəsini yazın."
msgstr "Bankbeleg- oder Zahlungsauftragsnummer eingeben."

msgctxt "registrar.retake"
msgid "Bu müraciət üzrə qaytarılma qərarı artıq verilib."
msgstr "Für diesen Antrag wurde bereits eine Erstattungsentscheidung erlassen."

msgctxt "registrar.retake"
msgid "Bu müraciət üzrə qaytarılma qərarı yoxdur."
msgstr "Für diesen Antrag gibt es keine Erstattungsentscheidung."

msgctxt "registrar.retake"
msgid "Qaytarılacaq məbləğ ödənilən məbləğdən çox ola bilməz."
msgstr "Die Erstattung darf den gezahlten Betrag nicht übersteigen."

msgctxt "registrar.retake"
msgid "Qaytarılma qərarı yalnız ödənişi təsdiqlənmiş və sonra rədd edilmiş, «İmtahana gəlmədi» və ya qərarla geri götürülmüş 25% müraciətinə verilir."
msgstr "Eine Erstattungsentscheidung ist nur für einen 25%-Antrag möglich, dessen Zahlung bestätigt und der danach abgelehnt, als „Nicht zur Prüfung erschienen“ markiert oder per Entscheidung zurückgezogen wurde."

msgctxt "registrar.retake"
msgid "Qaytarılma rəsmi qərarla olur: əmr nömrəsi və tarixi və ya qərar sənədi əlavə edin."
msgstr "Eine Erstattung braucht eine offizielle Entscheidung: Anordnungsnummer und -datum oder ein Entscheidungsdokument hinzufügen."

msgctxt "registrar.retake"
msgid "Qaytarılma tarixi düzgün deyil."
msgstr "Ungültiges Erstattungsdatum."

msgctxt "registrar.retake"
msgid "Qaytarılma tarixi gələcəkdə ola bilməz."
msgstr "Das Erstattungsdatum darf nicht in der Zukunft liegen."

msgctxt "registrar.retake"
msgid "Qaytarılma tarixi qərar tarixindən əvvəl ola bilməz."
msgstr "Das Erstattungsdatum darf nicht vor dem Entscheidungsdatum liegen."

msgctxt "registrar.retake"
msgid "Qaytarılma tarixini yazın."
msgstr "Erstattungsdatum eingeben."

msgctxt "registrar.retake"
msgid "Ödəniş artıq qaytarılmış kimi qeyd olunub."
msgstr "Die Zahlung ist bereits als erstattet erfasst."

msgctxt "registrar.retake"
msgid "Qaytarılma qərarı yazıldı — Mühasibatlığa bildiriş göndərildi."
msgstr "Erstattungsentscheidung erfasst — die Buchhaltung wurde benachrichtigt."

msgctxt "registrar.retake"
msgid "Ödəniş qaytarılmış kimi qeyd olundu."
msgstr "Zahlung als erstattet erfasst."

msgctxt "registrar.retake.notification"
msgid "Ödənişin qaytarılması qərarı verildi"
msgstr "Erstattungsentscheidung erlassen"

msgctxt "registrar.retake.notification"
msgid "Ödəniş qaytarıldı"
msgstr "Zahlung erstattet"

msgctxt "registrar.retake.notification"
msgid "Qaytarılacaq ödəniş növbədədir"
msgstr "Eine Erstattung wartet in der Warteschlange"

msgctxt "registrar.retake.notification"
msgid "{student} — {message}"
msgstr "{student} — {message}"

msgctxt "registrar.retake.notification"
msgid "\"{subject}\" — 25% ödənişi qaytarıldı: {amount} AZN ({date})."
msgstr "„{subject}“ — die 25%-Zahlung wurde erstattet: {amount} AZN ({date})."

msgctxt "registrar.retake.notification"
msgid "\"{subject}\" — 25% ödənişinin qaytarılması qərarı: {amount} AZN. Mühasibatlıq icra edəcək."
msgstr "„{subject}“ — Entscheidung zur Erstattung der 25%-Zahlung: {amount} AZN. Die Buchhaltung führt sie aus."

msgctxt "live_exam.presentation_style"
