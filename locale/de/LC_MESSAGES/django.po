msgctxt "registrar.journal_history"
msgid "Təkrar imtahan"
msgstr "Wiederholungsprüfung"

msgctxt "registrar.journal_history"
msgid "Sənədli düzəliş — bal / davamiyyət"
msgstr "Dokumentierte Korrektur — Punkte / Anwesenheit"

msgctxt "registrar.journal_history"
msgid "Sənədli düzəliş — dərs"
msgstr "Dokumentierte Korrektur — Unterrichtseinheit"

msgctxt "registrar.journal_history"
msgid "Sənədli düzəliş — dərs silindi"
msgstr "Dokumentierte Korrektur — Unterrichtseinheit gelöscht"

msgctxt "registrar.journal_history"
msgid "Sənədli düzəliş — sərbəst iş"
msgstr "Dokumentierte Korrektur — Selbststudium"

msgctxt "registrar.journal_history"
