msgstr ""
"Die Ankündigung erscheint nur im Bereich „Ankündigungen“ und im Zähler."

msgctxt "announcements.manage"
msgid "Girişdə necə göstərilsin"
msgstr "Wie bei der Anmeldung anzeigen"

msgctxt "announcements.manage"
msgid "Gözləyənlər"
msgstr "Ausstehend"

msgctxt "announcements.manage"
msgid "Hədəf auditoriyada heç kim yoxdur"
msgstr "Niemand gehört zur Zielgruppe"

msgctxt "announcements.manage"
msgid "Hədəf auditoriyanın hamısı təsdiq edib"
msgstr "Alle in der Zielgruppe haben bestätigt"

msgctxt "announcements.manage"
