#: apps/registrar/templates/registrar/partials/_jd_lesson_modal.html:39
msgctxt "registrar.journal"
msgid "Mövzunu seçin…"
msgstr "Выберите тему…"

#: apps/registrar/templates/registrar/partials/_jd_lesson_modal.html:45
msgctxt "registrar.journal"
msgid "Mövzunu yazın…"
msgstr "Введите тему…"

#: apps/registrar/templates/registrar/partials/_jd_lesson_modal.html:46
msgctxt "registrar.journal"
msgid "Kursun mövzu siyahısı yoxdur — mövzunu əl ilə yazın."
msgstr "У курса нет списка тем — введите тему вручную."

