msgctxt "registrar.legacy_grade"
msgid ""
"Bu nəticə köhnə sistemdən köçürülüb və dəqiq olmaya bilər — dəqiqləşdirmək "
"üçün İmtahan Mərkəzinə müraciət et."
msgstr ""
"Bu sonuç eski sistemden aktarıldı ve kesin olmayabilir — netleştirmek için "
"Sınav Merkezi’ne başvurun."

