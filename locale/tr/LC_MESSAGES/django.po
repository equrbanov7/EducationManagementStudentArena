msgid "EMSArena | Xoş gəldiniz"
msgstr "EMSArena | Hoş geldiniz"

msgid "Xoş gəldiniz!"
msgstr "Hoş geldiniz!"

msgid ""
"EMSArena blogumuza abunə olduğunuz üçün təşəkkür edirik. Ən son məqalə və "
"xəbərlərdən ilk siz xəbərdar olacaqsınız."
msgstr ""
"EMSArena blogumuza abone olduğunuz için teşekkür ederiz. En son makale ve "
"haberlerden ilk siz haberdar olacaksınız."

msgid "Abunəliyinizi istənilən vaxt ləğv edə bilərsiniz."
msgstr "Aboneliğinizi istediğiniz zaman iptal edebilirsiniz."

msgid "400 – Yanlış Sorğu | EMSArena"
msgstr "400 – Hatalı İstek | EMSArena"

msgid "Sorğu xətası"
msgstr "İstek hatası"

msgid "Yanlış sorğu göndərildi"
msgstr "Geçersiz istek gönderildi"

msgid ""
"Sorğu emal olunmadı. Daxil etdiyiniz məlumatlardan biri düzgün formatda "
"olmaya bilər"
msgstr ""
"İstek işlenemedi. Girdiğiniz bilgilerden biri doğru formatta olmayabilir"

msgid "və ya keçid artıq etibarsızdır."
msgstr "veya bağlantı artık geçersizdir."

msgid "Məlumatı yenidən yoxlayın"
msgstr "Bilgiyi tekrar kontrol edin"

msgid "Keçidin tam açıldığını təsdiqləyin"
msgstr "Bağlantının tam olarak açıldığını doğrulayın"

msgid "Ana səhifəyə qayıt"
msgstr "Ana sayfaya dön"

msgid "Əvvəlki səhifəyə dön"
msgstr "Önceki sayfaya dön"

msgid ""
"Problem davam etsə, son əməliyyatı yenidən edin və ya administratorla əlaqə "
"saxlayın."
msgstr ""
"Sorun devam ederse son işlemi yeniden yapın veya yöneticiyle iletişime "
"geçin."

msgid "Sorğuda gözlənilən format və ya tələb olunan məlumat uyğun gəlmədi."
msgstr "İstekte beklenen format veya gerekli bilgiler eşleşmedi."

msgid "403 – Giriş Qadağandır | EMSArena"
msgstr "403 – Erişim Yasak | EMSArena"

msgid "İcazə məhduddur"
msgstr "İzin sınırlıdır"

msgid "Bu səhifəyə giriş qadağandır"
msgstr "Bu alana erişim hakkınız yok."

msgid "Bu bölməyə baxmaq üçün hesabınızda kifayət qədər icazə yoxdur."
msgstr "Bu bölümü görüntülemek için hesabınızda yeterli izin yok."

msgid ""
"Düzgün hesabla daxil olduğunuzu yoxlayın və lazım gələrsə administratora "
"müraciət edin."
msgstr ""
"Doğru hesapla giriş yaptığınızı kontrol edin ve gerekirse yöneticiye "
"başvurun."

msgid "Hesabınızı yenidən yoxlayın"
msgstr "Hesabınızı tekrar kontrol edin"

msgid "Təşkilat icazələri tətbiq oluna bilər"
msgstr "Kuruluş izinleri uygulanabilir"

msgid "Giriş hüququ sizdə olmalıdırsa, sistem administratoru ilə paylaşın."
msgstr ""
"Erişim hakkına sahip olmanız gerekiyorsa, bunu sistem yöneticisiyle "
"paylaşın."

msgid "Sorğu tanındı, amma bu resursa girişə icazə verilmədi."
msgstr "İstek tanındı ancak bu kaynağa erişime izin verilmedi."

msgid "404 – Səhifə Tapılmadı | EMSArena"
msgstr "404 – Sayfa Bulunamadı | EMSArena"

msgid "Səhifə tapılmadı"
msgstr "Sayfa bulunamadı"

msgid "Axtardığınız səhifə burada deyil"
msgstr "Aradığınız sayfa burada değil"

msgid "Keçid dəyişmiş, silinmiş və ya yanlış daxil edilmiş ola bilər."
msgstr "Bağlantı değiştirilmiş, silinmiş veya yanlış girilmiş olabilir."

msgid ""
"Bir addım geri dönə və ya əsas səhifədən yolunuza davam edə bilərsiniz."
msgstr ""
"Bir adım geri dönebilir veya ana sayfadan yolunuza devam edebilirsiniz."

msgid "URL-ni yenidən yoxlayın"
msgstr "URL'yi tekrar kontrol edin"

msgid ""
"Əgər bu keçid işləməli idisə, onu paylaşdığınız səhifəni və ya yönləndirməni"
" yoxlayın."
msgstr ""
"Bu bağlantının çalışması gerekiyorduysa, paylaştığınız sayfayı veya "
"yönlendirmeyi kontrol edin."

msgid "İstənilən resurs serverdə tapılmadı və ya artıq əlçatan deyil."
msgstr "İstenen kaynak sunucuda bulunamadı veya artık erişilebilir değil."

msgid "500 – Server Xətası | EMSArena"
msgstr "500 – Sunucu Hatası | EMSArena"

msgid "Server xətası"
msgstr "Sunucu hatası"

msgid "Sistem gözlənilməz xətaya düşdü"
msgstr "Sistem beklenmeyen bir hatayla karşılaştı"

msgid ""
"Bu problem adətən müvəqqəti olur. Bir az sonra yenidən cəhd edə və ya "
"əvvəlki səhifəyə qayıdaraq"
msgstr ""
"Bu sorun genellikle geçicidir. Kısa bir süre sonra tekrar deneyebilir veya "
"önceki sayfaya dönerek"

msgid "əməliyyatı təkrarlaya bilərsiniz."
msgstr "işlemi tekrarlayabilirsiniz."

msgid "Bir neçə saniyə sonra yenidən yoxlayın"
msgstr "Birkaç saniye sonra tekrar kontrol edin"

msgid "Sistem hazırda cavab verə bilmir"
msgstr "Sistem şu anda yanıt veremiyor"

msgid "Geri qayıt və yenidən cəhd et"
msgstr "Geri dön ve tekrar dene"

msgid ""
"Problem təkrarlanarsa, vaxtı və etdiyiniz addımı paylaşın ki, səbəbi daha "
"tez tapa bilək."
msgstr ""
"Sorun tekrarlanırsa, nedenini daha hızlı bulabilmemiz için zamanı ve "
"yaptığınız adımı paylaşın."

msgid "Server sorğunu tamamlayarkən daxili xəta ilə qarşılaşdı."
msgstr "Sunucu isteği tamamlarken dahili bir hatayla karşılaştı."

