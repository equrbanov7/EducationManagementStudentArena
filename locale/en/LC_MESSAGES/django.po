msgctxt "blog.about_page"
msgid "title"
msgstr "About EMSArena | Education Platform"

msgctxt "blog.about_page"
msgid "hero_title"
msgstr "Education Management and Student Assessment Platform"

msgctxt "blog.about_page"
msgid "hero_description"
msgstr "EMSArena is a unified, scalable, and multifunctional digital education ecosystem designed for universities, schools, training centers, and individual instructors. We digitize the learning process and simplify management."

msgctxt "blog.about_page"
msgid "section_title"
msgstr "Platform Advantages and Capabilities"

msgctxt "blog.about_page"
msgid "feature_1_title"
msgstr "Unified Content Management"

msgctxt "blog.about_page"
msgid "feature_1_text"
msgstr "Share and manage academic and teaching materials (lecture notes, presentations, files, useful links, etc.) from a single central platform."

msgctxt "blog.about_page"
msgid "feature_2_title"
msgstr "Digitized Teaching"

msgctxt "blog.about_page"
msgid "feature_2_text"
msgstr "Organize courses, topics, resources, and assignments in a unified, structured way. Move the teaching process fully into a digital environment."

msgctxt "blog.about_page"
msgid "feature_3_title"
msgstr "Personalized Portals and Dashboards"

msgctxt "blog.about_page"
msgid "feature_3_text"
msgstr "Dedicated dashboards for teachers, students, and administrators. Includes e-journal, grading, attendance, and analytics-based performance monitoring."

msgctxt "blog.about_page"
msgid "feature_4_title"
msgstr "Multi-format Assessment"

msgctxt "blog.about_page"
msgid "feature_4_text"
msgstr "Conduct tests, written, practical, and real-time (live) exams. Build extensive question banks and mock exams."

msgctxt "blog.about_page"
msgid "feature_5_title"
msgstr "Multi-tenant Structure"

msgctxt "blog.about_page"
msgid "feature_5_text"
msgstr "Multiple organizations can operate on the same platform. Each organization has separate role and management rules with fully isolated data security."

msgctxt "blog.about_page"
msgid "cta_text"
msgstr "Discover the future of education with EMSArena."

