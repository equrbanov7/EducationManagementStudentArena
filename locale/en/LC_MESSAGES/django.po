msgstr "Reason for revision"

msgctxt "accounts.syllabus"
msgid "Konkret yazın: hansı bölmədə nə düzəldilməlidir."
msgstr "Be specific: which section needs what correction."

msgctxt "accounts.syllabus"
msgid "Düzəliş tələb olunan bölmələr"
msgstr "Sections that need revision"

msgctxt "accounts.syllabus"
msgid "Düzəliş üçün geri qaytar"
msgstr "Return for revision"

msgctxt "accounts.syllabus"
msgid "Sillabus rədd edilsin?"
msgstr "Reject the syllabus?"

msgctxt "accounts.syllabus"
msgid "Rədd edilən versiya bağlanır və yenidən göndərilə bilmir — müəllim yeni versiya yaratmalıdır. Səbəb məcburidir və audit izinə yazılır."
msgstr "A rejected version is closed and cannot be resubmitted — the teacher has to create a new version. A reason is mandatory and is written into the audit trail."

msgctxt "accounts.syllabus"
msgid "Rədd et"
msgstr "Reject"

msgctxt "accounts.syllabus"
msgid "Rədd səbəbi"
msgstr "Reason for rejection"

msgctxt "accounts.syllabus"
msgid "Məsələn: qiymətləndirmə strukturu universitet siyasətinə uyğun deyil."
msgstr "For example: the assessment structure does not comply with university policy."

msgctxt "accounts.syllabus"
msgid "Mövcud təsdiqlənmiş versiya (varsa) aktiv qalır"
msgstr "The existing approved version (if any) stays active"

msgctxt "accounts.syllabus"
msgid "Tələbələr köhnə təsdiqlənmiş versiyanı görməyə davam edir"
msgstr "Students keep seeing the previously approved version"

msgctxt "accounts.syllabus"
msgid "Jurnal statusu dəyişmir"
msgstr "The journal status does not change"

msgctxt "accounts.syllabus"
msgid "Ləğv et"
msgstr "Cancel"

msgctxt "accounts.syllabus"
msgid "Səbəb müəllimə göndərilir və audit izinə yazılır"
msgstr "The reason is sent to the teacher and written into the audit trail"

msgctxt "accounts.syllabus"
msgid "Ən azı %(min)s simvol — səbəb məcburidir"
msgstr "At least %(min)s characters — a reason is mandatory"

msgctxt "accounts.syllabus"
msgid "Səbəb ən azı %(min)s simvol olmalıdır."
msgstr "The reason must be at least %(min)s characters long."

msgctxt "accounts.syllabus"
msgid "Aktiv təşkilat seçilməyib."
msgstr "No active organization is selected."

msgctxt "accounts.syllabus"
msgid "Sillabus versiyası tapılmadı və ya əhatənizdə deyil."
msgstr "The syllabus version was not found or is outside your scope."

msgctxt "accounts.syllabus"
msgid "Sorğu düzgün deyil."
msgstr "The request is not valid."

msgctxt "accounts.syllabus"
msgid "Əməliyyat yerinə yetirilmədi."
msgstr "The operation was not completed."

msgctxt "accounts.syllabus"
msgid "Yüklənir…"
msgstr "Loading…"

msgctxt "accounts.syllabus"
msgid "%(name)s — %(version)s təsdiqləndi və kilidləndi."
msgstr "%(name)s — %(version)s was approved and locked."

msgctxt "accounts.syllabus"
msgid "%(name)s — düzəliş üçün geri qaytarıldı, müəllimə bildiriş göndərildi."
msgstr "%(name)s — returned for revision, the teacher has been notified."

msgctxt "accounts.syllabus"
msgid "%(name)s — versiya rədd edildi. Tələbələr köhnə təsdiqlənmiş versiyanı görür."
msgstr "%(name)s — the version was rejected. Students see the previously approved version."
