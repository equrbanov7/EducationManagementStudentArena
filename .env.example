# ═══════════════════════════════════════════════════════════════════════════
# EMS Arena — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# Do NOT commit your real .env file — it is listed in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════


# ── Django core ─────────────────────────────────────────────────────────────
# REQUIRED in all environments.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Which settings module to load.
# Use config.settings.local for development,
# config.settings.production for production.
DJANGO_SETTINGS_MODULE=config.settings.local

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Example (production): emsarena.az,www.emsarena.az
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of origins trusted for CSRF.
# Must include scheme (https://…).
# Example: https://emsarena.az,https://www.emsarena.az
CSRF_TRUSTED_ORIGINS=

# Canonical site URL used in emails and other absolute links.
SITE_URL=http://127.0.0.1:8000


# ── Database ────────────────────────────────────────────────────────────────
# Full DSN passed to dj-database-url.
# Production example: postgres://user:password@host:5432/dbname
# Leave unset in local dev to fall back to SQLite.
DATABASE_URL=postgres://emsarena:emsarena@localhost:5432/emsarena

# Individual vars used by the docker-compose files to bootstrap the DB.
POSTGRES_DB=emsarena
POSTGRES_USER=emsarena
POSTGRES_PASSWORD=change-me-strong-db-password


# ── Redis ───────────────────────────────────────────────────────────────────
# Full Redis DSN consumed by Django (channel layers + cache).
# Include the password in production: redis://:PASSWORD@redis:6379/0
# For local dev without a password: redis://127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Password used to protect Redis in the production docker-compose stack.
# Must match the password embedded in REDIS_URL above.
# REQUIRED when using docker-compose.prod.yml.
REDIS_PASSWORD=change-me-strong-redis-password


# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Leave blank in development to fall back to the console email backend.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@emsarena.az


# ── Security (production) ────────────────────────────────────────────────────
# These default to True in config.settings.production; you can override here.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# ── Sentry (optional) ────────────────────────────────────────────────────────
# Set to your project DSN to enable error tracking.  Leave blank to disable.
SENTRY_DSN=


# ── Live exam / LAN ──────────────────────────────────────────────────────────
LAN_HOST=emsarena.az
LIVE_EXAM_PUBLIC_HOST=


# ── Rate limiting (optional overrides) ──────────────────────────────────────
# LOGIN_RATE_LIMIT=5/10m
# OTP_VERIFY_RATE_LIMIT=5/10m
# OTP_RESEND_RATE_LIMIT=3/10m
# SUBSCRIBE_RATE_LIMIT=3/10m
# LIVE_EXAM_JOIN_RATE_LIMIT=20/5m
# LIVE_STATE_RATE_LIMIT=120/1m
# LIVE_REACTION_RATE_LIMIT=3/10s
# AUTH_OTP_EXPIRY_SECONDS=180


# ── Development extras ───────────────────────────────────────────────────────
# Enable ngrok support for local WebSocket testing over the internet.
ENABLE_NGROK=False

# pgAdmin (docker-compose.dev.yml only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me


# ── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO
