# EMS Arena secure environment example

DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

POSTGRES_DB=emsarena_db
POSTGRES_USER=emsarena_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://emsarena_user:replace-with-a-strong-password@localhost:5432/emsarena_db
POSTGRES_MAX_CONNECTIONS=200
DATABASE_CONN_MAX_AGE=0
ASGI_THREADS=8
PGBOUNCER_POOL_MODE=session
PGBOUNCER_MAX_CLIENT_CONN=1000
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_AUTH_TYPE=scram-sha-256

REDIS_URL=redis://localhost:6379/0

# Docker production scaling
APP_REPLICAS=4
CELERY_REPLICAS=2
CELERY_WORKER_CONCURRENCY=2

# Monitoring
METRICS_ALLOW_ANONYMOUS=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
GRAFANA_ROOT_URL=http://127.0.0.1:3000

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0

# S3-compatible object storage (Linode Object Storage / AWS S3 / MinIO)
OBJECT_STORAGE_ENABLED=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://eu-central-1.linodeobjects.com
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=900

LOCAL_USE_SMTP_EMAIL=True
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
BREVO_SMTP_LOGIN=replace-with-your-brevo-smtp-login
BREVO_EMAIL=no-reply@emsarena.com
BREVO_FROM_EMAIL=no-reply@emsarena.com
BREVO_SMTP_KEY=replace-with-your-brevo-smtp-key
BREVO_API_KEY=replace-with-your-brevo-api-key
DEFAULT_FROM_EMAIL=no-reply@emsarena.com
EMAIL_TIMEOUT=10

AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS_PER_HOUR=5

# AI / Gemini (for exam analytics AI summaries + AI assistant)
GEMINI_API_KEY=
# Optional AI assistant tuning (sensible defaults applied when unset):
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Practical coding exam — sandbox executor
# ---------------------------------------------------------------------------
# Backend used to run student code submitted in practical / coding exams.
#   docker  – use the local Docker daemon (best isolation, requires Docker).
#   piston  – always forward to a Piston HTTP server (no Docker needed).
#   auto    – use Docker if reachable, else fall back to Piston (recommended).
CODING_EXECUTION_BACKEND=auto
# Piston endpoint. The public emkc.org instance is fine for local dev.
CODING_PISTON_URL=https://emkc.org/api/v2/piston
# Auth header for self-hosted Piston (leave blank for the public instance).
CODING_PISTON_AUTH_TOKEN=
# Per-organization soft rate limit for the Run Code button (requests / minute).
# Stops a single classroom from saturating the executor pool. 0 disables it.
CODING_RUN_RATE_LIMIT_PER_MINUTE=120
# Maximum concurrent runs per student. Prevents one student from queueing
# dozens of submissions while a slow one is still pending.
CODING_RUN_MAX_CONCURRENT_PER_USER=2
