# ═══════════════════════════════════════════════════════════════════════════
# EMS ARENA — LOKAL DEV üçün .env nümunəsi
# ═══════════════════════════════════════════════════════════════════════════
# Kopyala:  cp .env.example .env   və dəyərləri doldur.
# Production üçün: .env.production.example
# QEYD: Bütün dəyərlər saxtadır (CHANGE_ME) — real sirr COMMIT ETMƏYİN.
# ═══════════════════════════════════════════════════════════════════════════

# ── Django nüvəsi ───────────────────────────────────────────────────────────
# Generasiya: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Verilənlər bazası ──────────────────────────────────────────────────────
# Docker dev stack (docker-compose.yml) üçün:
POSTGRES_DB=emsarena
POSTGRES_USER=emsarena
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://emsarena:CHANGE_ME@localhost:5432/emsarena
# Sürətli Postgres-siz test üçün: DATABASE_URL=sqlite:///db.sqlite3

# ── Redis / Cache ──────────────────────────────────────────────────────────
USE_REDIS=True
REDIS_URL=redis://localhost:6379/0

# ── E-poçt (dev-də default konsola yazılır) ────────────────────────────────
LOCAL_USE_SMTP_EMAIL=False
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
BREVO_SMTP_LOGIN=
BREVO_EMAIL=
BREVO_SMTP_KEY=
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@localhost

# ── OTP / auth limitləri ───────────────────────────────────────────────────
AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS_PER_HOUR=5

# ── AI (opsional) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Canlı imtahan / LAN ────────────────────────────────────────────────────
LAN_HOST=localhost
LIVE_EXAM_PUBLIC_HOST=localhost
ENABLE_NGROK=False

# ── Praktiki (coding) imtahan sandbox-u (dev) ──────────────────────────────
CODING_EXECUTION_BACKEND=auto
CODING_PISTON_URL=http://localhost:2000/api/v2
CODING_PISTON_AUTH_TOKEN=
CODING_RUN_RATE_LIMIT_PER_MINUTE=600
CODING_RUN_MAX_CONCURRENT_PER_USER=2

# ── Dev alətləri (docker-compose.dev.yml) ──────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
