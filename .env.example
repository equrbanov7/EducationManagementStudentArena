# EMS Arena secure environment example

DEBUG=True
SECRET_KEY=replace-with-a-random-secret-key
SITE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

POSTGRES_DB=emsarena_db
POSTGRES_USER=emsarena_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://emsarena_user:replace-with-a-strong-password@localhost:5432/emsarena_db

REDIS_URL=redis://localhost:6379/0

LOCAL_USE_SMTP_EMAIL=True
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
BREVO_SMTP_LOGIN=replace-with-your-brevo-smtp-login
BREVO_EMAIL=no-reply@emsarena.com
BREVO_FROM_EMAIL=no-reply@emsarena.com
BREVO_SMTP_KEY=replace-with-your-brevo-smtp-key
DEFAULT_FROM_EMAIL=no-reply@emsarena.com
EMAIL_TIMEOUT=10

AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_MAX_SENDS_PER_HOUR=5

# AI / Gemini (for exam analytics AI summaries)
GEMINI_API_KEY=
