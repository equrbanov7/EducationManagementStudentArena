# EMSArena off-site backup — copy to /etc/emsarena/offsite-backup.env (root:root, chmod 600).
# Read by scripts/ops/offsite_backup.sh and the emsarena-offsite-backup.service unit.
# Audit 2026-09-28 AD-01. Never commit the real file.

# Where the encrypted repository lives (pick ONE backend):
#   S3-compatible bucket (AWS, Backblaze B2 S3 API, MinIO on the university NAS):
OFFSITE_RESTIC_REPOSITORY=s3:https://s3.example.org/emsarena-backups/prod
#   SFTP to a NAS / second server (also set OFFSITE_SSH_DIR to a dir with a key + known_hosts):
# OFFSITE_RESTIC_REPOSITORY=sftp:backup@nas.example.local:/srv/restic/emsarena
# OFFSITE_SSH_DIR=/root/.ssh-emsarena-backup
#   rclone remote (needs restic + rclone on the host):
# OFFSITE_RESTIC_MODE=host
# OFFSITE_RESTIC_REPOSITORY=rclone:offsite:emsarena

# Encryption password file (generate: openssl rand -base64 48 > /etc/emsarena/restic.pass;
# chmod 600). Keep a second copy OFF the server (password manager / sealed envelope):
# without it the repository cannot be restored.
OFFSITE_RESTIC_PASSWORD_FILE=/etc/emsarena/restic.pass

# Backend credentials (S3 example):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Sources (defaults shown; set to an empty value to skip one on purpose):
# OFFSITE_SIDECAR_DUMPS=/home/wcu/EducationManagementStudentArena/backups/postgres
# OFFSITE_HOST_DUMPS=/var/backups/emsarena
# OFFSITE_MEDIA_VOLUME=            # auto-detected from emsarena-nginx; e.g. educationmanagementstudentarena_media_data

# Retention (snapshots kept in the repository):
# OFFSITE_KEEP_DAILY=7
# OFFSITE_KEEP_WEEKLY=4
# OFFSITE_KEEP_MONTHLY=6
# OFFSITE_RESTIC_CHECK=0           # 1 = `restic check` after every prune
