# ═══════════════════════════════════════════════════════════════════════════
# EMS ARENA — PRODUCTION üçün .env nümunəsi (docker-compose.prod.yml)
# ═══════════════════════════════════════════════════════════════════════════
# Server-də /opt/emsarena/app/.env kimi yerləşdirilir (rsync .env-i sync
# ETMİR; ilk dəfə əl ilə yaradılır, sonra CI ENV_OVERRIDES ilə upsert edir).
# QEYD: Bütün dəyərlər saxtadır (CHANGE_ME) — real sirr COMMIT ETMƏYİN.
# MƏCBURİ dəyişənlər: SECRET_KEY, POSTGRES_*, REDIS_PASSWORD, ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS, SITE_URL, GRAFANA_ADMIN_PASSWORD (fail-fast!).
# ═══════════════════════════════════════════════════════════════════════════

# ── Django nüvəsi ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
# LAN yerləşdirməsi: istifadəçilər serverə IP ilə girir (publik domen yoxdur).
ALLOWED_HOSTS=10.0.2.42,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://10.0.2.42
SITE_URL=https://10.0.2.42
LAN_HOST=10.0.2.42
LIVE_EXAM_PUBLIC_HOST=10.0.2.42
APP_ENV=production
APP_VERSION=unknown

# ── Edge / trusted proxy ──────────────────────────────────────────────────
# İki rejim var; proxy/CDN rejimləri fail-closed rədd edilir:
#   lan    — müəssisədaxili server, publik DNS yoxdur (hazırkı production).
#   direct — publik domen birbaşa bu serverə baxır (DNS+publik-CA preflight).
EDGE_PROXY_MODE=lan
# Yalnız EDGE_PROXY_MODE=direct üçün MƏCBURİDİR: domenin public DNS A/AAAA
# cavablarının DƏQİQ siyahısı (vergül/boşluqla). lan rejimində istifadə olunmur.
# DIRECT_ORIGIN_IPS=CHANGE_ME_TO_SERVER_PUBLIC_IP
# Docker deploy-un origin-daxili health probe-u.
APP_BASE_URL=https://127.0.0.1
# Health probe-ların Host başlığı; lan rejimində serverin LAN IP-si.
HEALTHCHECK_HOST=10.0.2.42
# Loopback probe 127.0.0.1-ə qoşulduğu üçün hostname yoxlamasını curl-da etmir;
# deploy bundan ƏVVƏL cert chain/hostname/key/expiry-ni openssl ilə sərt yoxlayır.
ORIGIN_HEALTHCHECK_INSECURE_TLS=true
# docker/nginx/certs/origin.crt + origin.key. direct rejimdə public-CA fullchain
# MƏCBURİDİR; lan rejimində SAN-ı LAN IP-ni əhatə edən self-signed sertifikata
# TLS_ALLOW_SELF_SIGNED_LOCAL=true ilə icazə verilir.
# Sertifikat bitməsinə ən azı 7 gün qalmalıdır; renewal/regen nginx-i reload etsin.
TLS_CERT_MIN_VALIDITY_SECONDS=604800
TLS_ALLOW_SELF_SIGNED_LOCAL=true

# ── PostgreSQL / PgBouncer ─────────────────────────────────────────────────
POSTGRES_DB=emsarena
POSTGRES_USER=emsarena
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_MAX_CONNECTIONS=200
# EXAM-P0-01: runtime üçün NOSUPERUSER NOBYPASSRLS tətbiq rolu — superuser
# FORCE RLS-i belə yan keçdiyi üçün MÜTLƏQDİR. Mövcud DB-də rolu
# scripts/provision-app-db-role.sh ilə yaradın; boş qalsa köhnə (superuser)
# davranışa düşür və app loglarında organizations.W011 xəbərdarlığı görünür.
APP_DATABASE_USER=emsarena_app
APP_DATABASE_PASSWORD=CHANGE_ME
# DB rol yoxlamasının sərtliyi: warn | error | off (rol quraşdırıldıqdan
# sonra "error" edin ki, superuser-ə qayıdış deploy-u bloklasın).
EMS_DB_ROLE_ENFORCE=warn
# DİQQƏT: session mode RLS GUC üçün QƏSDƏNDİR — transaction-a keçid yalnız
# docs/performance/FAZA2_3B_TRANSACTION_POOLING.md planı ilə.
PGBOUNCER_POOL_MODE=session
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MAX_CLIENT_CONN=1000
DATABASE_CONN_MAX_AGE=0

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Daphne / miqyas ────────────────────────────────────────────────────────
ASGI_THREADS=8
# APP_REPLICAS / CELERY_REPLICAS deploy skriptində istifadə olunur.

# ── Admin qoruması ─────────────────────────────────────────────────────────
ADMIN_URL_PREFIX=manage/
ADMIN_ALLOWED_IPS=
ADMIN_2FA_REQUIRED=True

# ── E-poçt (Brevo SMTP) ────────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
BREVO_SMTP_LOGIN=CHANGE_ME
BREVO_SMTP_KEY=CHANGE_ME
BREVO_EMAIL=CHANGE_ME
BREVO_FROM_EMAIL=no-reply@emsarena.com
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@emsarena.com

# ── Monitorinq / Alerting (Faza 1) ─────────────────────────────────────────
# Grafana BOŞ OLA BİLMƏZ — compose fail-fast edir:
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Alert e-poçtlarının ünvanı (Alertmanager, Brevo SMTP ilə göndərir).
# Dəyərlərdə '|' və '&' istifadə etməyin (template sed qaydası).
ALERT_EMAIL_TO=ops@emsarena.com
ALERT_EMAIL_FROM=no-reply@emsarena.com
# PROMETHEUS_PORT=9090  GRAFANA_PORT=3000  ALERTMANAGER_PORT=9093
# PROMETHEUS_RETENTION_TIME=15d

# ── Sentry (opsional) ──────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── AI (opsional) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
AI_RATE_LIMIT=100/1h
AI_ASSISTANT_RATE_LIMIT=25/1h

# ── Backup rotasiyası ──────────────────────────────────────────────────────
POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=3

# ── Hesab provisioning (e-universitet) ─────────────────────────────────────
# Public self-registration DEFAULT olaraq BAĞLIDIR: hesablar universitet
# administrasiyası tərəfindən yaradılır (bax docs/operations/ACCOUNT_PROVISIONING.md).
# `/accounts/register/` login-ə yönləndirir və navbar/footer signup linkləri
# gizlənir. Yalnız qeyri-universitet tenant / marketinq pilotu üçün açın.
PUBLIC_SIGNUP_ENABLED=false

# ── Obyekt yaddaşı (opsional, S3-uyğun) ────────────────────────────────────
OBJECT_STORAGE_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# ── Resurs limitləri (istəyə görə köklə; defaultlar compose-dadır) ─────────
# APP_MEM_LIMIT=1536M       APP_CPU_LIMIT=1.5
# CELERY_MEM_LIMIT=1024M    POSTGRES_MEM_LIMIT=2048M
# REDIS_MEM_LIMIT=512M      NGINX_MEM_LIMIT=256M

# ── Kodlama sandbox (Piston) — yalnız `coding` profili aktiv olduqda ───────
# Reproduksiya olunan build üçün image-i konkret digest-ə pin-ləyin
# (compose default-u `:latest`-dir; production-da digest tövsiyə olunur).
# PISTON_IMAGE=ghcr.io/engineer-man/piston@sha256:<digest>
