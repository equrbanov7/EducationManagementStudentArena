# ═══════════════════════════════════════════════════════════════════════════
# EMS ARENA — PRODUCTION üçün .env nümunəsi (docker-compose.prod.yml)
# ═══════════════════════════════════════════════════════════════════════════
# Server-də /opt/emsarena/app/.env kimi yerləşdirilir (rsync .env-i sync
# ETMİR; ilk dəfə əl ilə yaradılır, sonra CI ENV_OVERRIDES ilə upsert edir).
# QEYD: Bütün dəyərlər saxtadır (CHANGE_ME) — real sirr COMMIT ETMƏYİN.
# MƏCBURİ dəyişənlər: SECRET_KEY, POSTGRES_*, REDIS_PASSWORD, ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS, SITE_URL, GRAFANA_ADMIN_PASSWORD (fail-fast!).
# ═══════════════════════════════════════════════════════════════════════════

# ── Django nüvəsi ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
# LAN yerləşdirməsi: istifadəçilər serverə IP ilə girir (publik domen yoxdur).
ALLOWED_HOSTS=10.0.2.42,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://10.0.2.42
SITE_URL=https://10.0.2.42
LAN_HOST=10.0.2.42
LIVE_EXAM_PUBLIC_HOST=10.0.2.42
APP_ENV=production
APP_VERSION=unknown

# ── Edge / trusted proxy ──────────────────────────────────────────────────
# İki rejim var; proxy/CDN rejimləri fail-closed rədd edilir:
#   lan    — müəssisədaxili server, publik DNS yoxdur (hazırkı production).
#   direct — publik domen birbaşa bu serverə baxır (DNS+publik-CA preflight).
EDGE_PROXY_MODE=lan
# Yalnız EDGE_PROXY_MODE=direct üçün MƏCBURİDİR: domenin public DNS A/AAAA
# cavablarının DƏQİQ siyahısı (vergül/boşluqla). lan rejimində istifadə olunmur.
# DIRECT_ORIGIN_IPS=CHANGE_ME_TO_SERVER_PUBLIC_IP
# Docker deploy-un origin-daxili health probe-u.
APP_BASE_URL=https://127.0.0.1
# Health probe-ların Host başlığı; lan rejimində serverin LAN IP-si.
HEALTHCHECK_HOST=10.0.2.42
# Loopback probe 127.0.0.1-ə qoşulduğu üçün hostname yoxlamasını curl-da etmir;
# deploy bundan ƏVVƏL cert chain/hostname/key/expiry-ni openssl ilə sərt yoxlayır.
ORIGIN_HEALTHCHECK_INSECURE_TLS=true
# docker/nginx/certs/origin.crt + origin.key. direct rejimdə public-CA fullchain
# MƏCBURİDİR; lan rejimində SAN-ı LAN IP-ni əhatə edən self-signed sertifikata
# TLS_ALLOW_SELF_SIGNED_LOCAL=true ilə icazə verilir.
# Sertifikat bitməsinə ən azı 7 gün qalmalıdır; renewal/regen nginx-i reload etsin.
TLS_CERT_MIN_VALIDITY_SECONDS=604800
TLS_ALLOW_SELF_SIGNED_LOCAL=true

# ── Sistem Monitorinqi (superadmin mərkəzi) ────────────────────────────────
# Alertmanager → Django webhook tokeni (insident + in-app bildiriş axını).
# Güclü random dəyər olmalıdır: openssl rand -hex 24
ALERTMANAGER_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN
# Daxili monitorinq servis ünvanları (default-lar compose şəbəkəsinə uyğundur;
# adətən dəyişdirməyə ehtiyac yoxdur).
# MONITORING_PROMETHEUS_URL=http://prometheus:9090
# MONITORING_LOKI_URL=http://loki:3100
# MONITORING_ALERTMANAGER_URL=http://alertmanager:9093

# ── PostgreSQL / PgBouncer ─────────────────────────────────────────────────
POSTGRES_DB=emsarena
POSTGRES_USER=emsarena
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_MAX_CONNECTIONS=200
# EXAM-P0-01: runtime üçün NOSUPERUSER NOBYPASSRLS tətbiq rolu — superuser
# FORCE RLS-i belə yan keçdiyi üçün MÜTLƏQDİR. Mövcud DB-də rolu
# scripts/provision-app-db-role.sh ilə yaradın; boş qalsa köhnə (superuser)
# davranışa düşür və app loglarında organizations.W011 xəbərdarlığı görünür.
APP_DATABASE_USER=emsarena_app
APP_DATABASE_PASSWORD=CHANGE_ME
# DB rol yoxlamasının sərtliyi: warn | error | off (rol quraşdırıldıqdan
# sonra "error" edin ki, superuser-ə qayıdış deploy-u bloklasın).
EMS_DB_ROLE_ENFORCE=warn
# DİQQƏT: session mode RLS GUC üçün QƏSDƏNDİR — transaction-a keçid yalnız
# docs/performance/FAZA2_3B_TRANSACTION_POOLING.md planı ilə.
PGBOUNCER_POOL_MODE=session
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_MAX_CLIENT_CONN=1000
# Bazaya gedən backend-lərin ümumi tavanı (bütün rollar üzrə): app rolu + owner
# rolu (miqrasiya) iki ayrı pool-dur, cəmi POSTGRES_MAX_CONNECTIONS-i keçməsin —
# həmişə POSTGRES_MAX_CONNECTIONS − 20 saxlayın.
PGBOUNCER_MAX_DB_CONNECTIONS=180
DATABASE_CONN_MAX_AGE=0

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ── Daphne / miqyas ────────────────────────────────────────────────────────
ASGI_THREADS=8
# APP_REPLICAS / CELERY_REPLICAS deploy skriptində istifadə olunur.

# ── Admin qoruması ─────────────────────────────────────────────────────────
ADMIN_URL_PREFIX=manage/
ADMIN_ALLOWED_IPS=
ADMIN_2FA_REQUIRED=True
# Admin OTP-ni söndürmək (LAN daxili yerləşdirmə, e-poçt hələ qurulmayıb) — yalnız
# şüurlu təsdiqlə: ADMIN_2FA_REQUIRED=False + ADMIN_2FA_DISABLE_ACK=I_UNDERSTAND
ADMIN_2FA_DISABLE_ACK=

# ── Təhlükəsizlik parametrləri (2026-09-14, təhlükəsizlik auditi F-09) ──────
# Aşağıdakıların HAMISININ kodda təhlükəsiz defoltu var — yalnız şüurlu
# dəyişiklik üçün açın. Göstərilən dəyərlər defoltlardır (real sirr yoxdur).
#
# TLS / kuki bayraqları — prod-da True olmalıdır; üçündən biri False olsa
# tətbiq QALXMIR (yeganə çıxış yolu INSECURE_TRANSPORT_OK, o da yalnız CI smoke üçün).
# SECURE_SSL_REDIRECT=True            # HTTP → HTTPS yönləndirməsi
# SESSION_COOKIE_SECURE=True          # sessiya kukisi yalnız HTTPS ilə
# CSRF_COOKIE_SECURE=True             # CSRF kukisi yalnız HTTPS ilə
# SECURE_HSTS_SECONDS=31536000        # HSTS müddəti (1 il); 0 → HSTS söndürülür
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True # HSTS alt-domenlərə də şamil olunsun
# SECURE_HSTS_PRELOAD=True            # HSTS preload siyahısı üçün başlıq
# INSECURE_TRANSPORT_OK=False         # prod .env-də OLMAMALIDIR (deploy dayanır)
#
# Sessiya ömrü (saniyə): mütləq ömür və hərəkətsizlik limiti.
# SESSION_COOKIE_AGE=86400            # 24 saat
# SESSION_INACTIVITY_TIMEOUT=28800    # 8 saat hərəkətsizlikdən sonra çıxış
# PASSWORD_RESET_TIMEOUT=300          # parol bərpa linkinin ömrü (= AUTH_OTP_EXPIRY_SECONDS)
#
# Giriş / OTP / admin rate-limit-ləri ("say/müddət"; boş və ya yanlış format
# boot-da rədd edilir — fail-closed).
# ADMIN_LOGIN_RATE_LIMIT=3/15m        # admin giriş cəhdi (istifadəçi üzrə)
# ADMIN_OTP_VERIFY_RATE_LIMIT=5/10m   # admin 2FA kod yoxlaması
# ADMIN_OTP_RESEND_RATE_LIMIT=3/10m   # admin 2FA kodun yenidən göndərilməsi
# LOGIN_RATE_LIMIT=5/10m              # adi giriş (istifadəçi adı üzrə)
# LOGIN_IP_RATE_LIMIT=60/10m          # adi giriş (IP üzrə)
# LOGIN_SUPERADMIN_ESCAPE_RATE_LIMIT=3/1h  # superadmin qaçış yolu
# OTP_VERIFY_RATE_LIMIT=5/10m         # e-poçt OTP yoxlaması (hesab üzrə)
# OTP_RESEND_RATE_LIMIT=3/10m         # e-poçt OTP yenidən göndərmə (hesab üzrə)
# OTP_SEND_IP_RATE_LIMIT=40/10m       # OTP göndərmə (IP üzrə)
# OTP_VERIFY_IP_RATE_LIMIT=100/10m    # OTP yoxlama (IP üzrə)
# AUTH_OTP_EXPIRY_SECONDS=300         # OTP kodunun ömrü
# AUTH_OTP_MAX_ATTEMPTS=5             # bir kod üçün maksimum cəhd
# AUTH_OTP_MAX_SENDS_PER_HOUR=5       # bir hesaba saatda göndərilən kod sayı
#
# Final imtahanı girişi: vergüllə IP/CIDR siyahısı; BOŞ = hamıya açıq.
# FINAL_EXAM_ALLOWED_IPS=
# FINAL_EXAM_PIN_MAX_FAILURES=5       # PIN səhvindən sonra kilid
# FINAL_EXAM_PIN_LOCK_MINUTES=10      # kilid müddəti
# FINAL_EXAM_ENTRY_RATE_PER_MINUTE=10 # giriş cəhdi limiti (dəqiqədə)
#
# Fayl yükləmə ümumi ölçü qapısı (MB); sahə-səviyyə limitlər ayrıca daha sərtdir.
# FILE_UPLOAD_SECURITY_MAX_SIZE_MB=25
#
# Kodlama sandbox-u (öz-hostlu Piston) üçün Authorization tokeni; publik
# emkc.org üçün boş qalır. Doldurulursa: openssl rand -hex 24
# CODING_PISTON_AUTH_TOKEN=
#
# SMTP parolu — BREVO_SMTP_KEY dolu olanda o üstünlük təşkil edir; bu yalnız
# Brevo olmayan SMTP üçündür.
# EMAIL_HOST_PASSWORD=
#
# /metrics/ endpoint-i anonim açıq olsun? Prod-da False (Prometheus daxili
# şəbəkədən token/IP ilə oxuyur).
# METRICS_ALLOW_ANONYMOUS=False
#
# Microsoft Clarity autentifikasiyalı kabinet səhifələrində də yüklənsin?
# Default False (tələbə PII/qiymətlər) — yalnız məxfilik qərarından sonra açın.
# MICROSOFT_CLARITY_AUTHENTICATED=False

# ── E-poçt (Brevo SMTP) ────────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
BREVO_SMTP_LOGIN=CHANGE_ME
BREVO_SMTP_KEY=CHANGE_ME
BREVO_EMAIL=CHANGE_ME
BREVO_FROM_EMAIL=no-reply@emsarena.com
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@emsarena.com
# Cavab ünvanı (Reply-To) — From-dan fərqli domen ola bilər, Brevo təsdiqi tələb etmir.
EMAIL_REPLY_TO=no-reply@wcu.edu.az

# ── Monitorinq / Alerting (Faza 1) ─────────────────────────────────────────
# Grafana BOŞ OLA BİLMƏZ — compose fail-fast edir:
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Alert e-poçtlarının ünvanı (Alertmanager, Brevo SMTP ilə göndərir).
# Dəyərlərdə '|' və '&' istifadə etməyin (template sed qaydası).
ALERT_EMAIL_TO=ops@emsarena.com
ALERT_EMAIL_FROM=no-reply@emsarena.com
# PROMETHEUS_PORT=9090  GRAFANA_PORT=3000  ALERTMANAGER_PORT=9093
# PROMETHEUS_RETENTION_TIME=15d

# ── Sentry (opsional) ──────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── AI (opsional) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
AI_RATE_LIMIT=100/1h
AI_ASSISTANT_RATE_LIMIT=25/1h
# AI çat-botu sahib açarı: false → vidcet «tezliklə» vəziyyətində, endpoint 503.
AI_ASSISTANT_ENABLED=true
# 2026-09-14 (audit F-08): AI köməkçisi jurnalı — saxlanan prompt uzunluğu və
# saxlama müddəti (gün; 0 → köhnə sətirlər silinmir). Tam e-poçt provayderə
# göndərilmir (`***@domain`).
# AI_ASSISTANT_LOG_MAX_CHARS=8000
# AI_ASSISTANT_LOG_RETENTION_DAYS=90

# ── Backup rotasiyası ──────────────────────────────────────────────────────
# go-cron: 5 sahəli cron və ya @daily; TZ ilə hesablanır. Hər gecə 01:00 Bakı:
POSTGRES_BACKUP_SCHEDULE="0 1 * * *"
POSTGRES_BACKUP_TZ=Asia/Baku
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=3
# postgres-backup konteynerinin yaddaş limiti (defolt 512M; 2026-09-15: 256M dump zamanı 90%-ə çatırdı)
# BACKUP_MEM_LIMIT=512M

# ── Hesab provisioning (e-universitet) ─────────────────────────────────────
# Public self-registration DEFAULT olaraq BAĞLIDIR: hesablar universitet
# administrasiyası tərəfindən yaradılır (bax docs/operations/ACCOUNT_PROVISIONING.md).
# `/accounts/register/` login-ə yönləndirir və navbar/footer signup linkləri
# gizlənir. Yalnız qeyri-universitet tenant / marketinq pilotu üçün açın.
PUBLIC_SIGNUP_ENABLED=false

# ── Obyekt yaddaşı (opsional, S3-uyğun) ────────────────────────────────────
OBJECT_STORAGE_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=



# ── Kodlama sandbox (Piston) — yalnız `coding` profili aktiv olduqda ───────
# Reproduksiya olunan build üçün image-i konkret digest-ə pin-ləyin
# (compose default-u `:latest`-dir; production-da digest tövsiyə olunur).
# PISTON_IMAGE=ghcr.io/engineer-man/piston@sha256:<digest>

# ── Deploy preflight (2026-09-13, Codex audit P1-08 / P1-07) ─────────────────
# `scripts/deploy/remote_deploy.sh` migrate-dən ƏVVƏL qurulmuş image-də
# `manage.py check --deploy` işlədir. 2026-09-14 infra auditi P3-16: defolt
# WARNING-dir — W004/W008/W012/W016 (HTTPS redirect, Secure cookie, HSTS)
# xəbərdarlıqları da deploy-u dayandırır (CI `_security.yml` ilə eyni sərtlik).
# Yalnız sənədləşdirilmiş, müvəqqəti yumşaltma üçün ERROR seçin (xəbərdarlıqlar
# yenə ucadan çap olunur).
# DEPLOY_CHECK_FAIL_LEVEL=WARNING
#
# `INSECURE_TRANSPORT_OK` yalnız CI smoke mühitləri üçündür — prod `.env`-də
# OLMAMALIDIR (varsa deploy qəsdən dayanır). TLS bayraqlarını kod defoltlarında
# saxlayın: SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE = True.
#
# Image damğası: deploy skripti Git SHA-nı özü tapır (BUILD_GIT_SHA → GITHUB_SHA →
# APP_DIR/.git); `/health/` cavabındakı `build.sha` işləyən image-in mənbədən
# geri qaldığını göstərir. Əl ilə: BUILD_GIT_SHA=<sha> bash scripts/deploy/remote_deploy.sh

# ── Deploy: SHA teqi, deploy-öncəsi dump, rollback (2026-09-14 infra auditi P2-5) ──
# remote_deploy.sh image-i `emsarena-prod:<git sha>` kimi qurur; `latest` yalnız
# health-gate keçəndən sonra bu teqə çevrilir. Qapı uğursuz olsa app/celery
# konteynerləri əvvəlki teqlə yenidən yaradılır (miqrasiya geri ALINMIR —
# deploy-öncəsi dump ./backups/postgres/last/ içindədir). Bax deployment.md §8.
# SKIP_PREDEPLOY_BACKUP=0          # 1 → migrate-dən əvvəl /backup.sh dump-ı atlanır (riski qəbul edərək)
# DEPLOY_ROLLBACK_ON_FAILURE=true  # false → uğursuz release yerində qalır (araşdırma üçün)
# DEPLOY_KEEP_RELEASE_IMAGES=3     # cari + rollback hədəfindən başqa saxlanılan köhnə teq sayı
#
# P3-9: blackbox probe-larının `Host` başlığı da yuxarıdakı HEALTHCHECK_HOST-dan
# render olunur (deploy health-gate ilə eyni dəyişən; ALLOWED_HOSTS-da olmalıdır).

# ── Şəbəkə zonası (publik domenə çıxış; bax docs/ops/PUBLIC_DOMAIN_ROLLOUT.md) ──
# Universitet daxili şəbəkələr (CIDR, vergüllə). nginx.conf-dakı `geo $ems_zone` ilə EYNİ olmalıdır.
INTERNAL_NETWORKS=10.0.0.0/8,127.0.0.0/8,::1/128
# True: /jurnal/ və inzibati hesablar yalnız daxili şəbəkədən (publik domenə çıxanda açın).
NETWORK_ZONE_ENFORCED=False
# True: nginx-in X-EMS-Zone başlığına inan (nginx müştəri başlığını əzir — yalnız bu compose ilə).
NETWORK_ZONE_TRUST_HEADER=False
