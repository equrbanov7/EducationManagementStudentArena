# Interactive AI-agent sandbox for EMS Arena.
#
# The regular development Dockerfile starts the Django server through an
# entrypoint. This image is intentionally shell-first: Claude/Codex can run
# checks, migrations, psql, and pytest commands against the compose PostgreSQL
# service without needing root access in an external sandbox.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        less \
        nodejs \
        npm \
        openssh-client \
        postgresql-client \
        procps \
        redis-tools \
        tesseract-ocr \
        tesseract-ocr-aze \
    && rm -rf /var/lib/apt/lists/*

COPY requirements /tmp/requirements
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements/agent.txt

CMD ["sleep", "infinity"]
