# Production Dockerfile for EMS Arena
# Pin by digest for supply-chain security.  To update, pull the new tag and
# replace the sha256 digest below:
#   docker pull python:3.12-slim-bookworm
#   docker inspect python:3.12-slim-bookworm --format '{{index .RepoDigests 0}}'
FROM python:3.12-slim-bookworm@sha256:31c0807da611e2e377a2e9b566ad4eb038ac5a5838cbbbe6f2262259b5dc77a0

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

# Set work directory
WORKDIR /app

# Apply all available OS security patches.
# APT_SECURITY_REFRESH is passed by CI so the package-upgrade layer is rebuilt
# on each workflow run instead of reusing stale cached CVE-bearing packages.
# libpq-dev, libc6-dev and gcc are required to compile psycopg2 from source;
# the official Python image already contains headers for /usr/local/bin/python.
ARG APT_SECURITY_REFRESH=manual
ARG APT_PRIMARY_MIRROR=https://deb.debian.org/debian
ARG APT_PRIMARY_SECURITY_MIRROR=https://deb.debian.org/debian-security
ARG APT_FALLBACK_MIRROR=https://ftp.debian.org/debian
ARG APT_FALLBACK_SECURITY_MIRROR=https://security.debian.org/debian-security
RUN set -eux; \
    write_debian_sources() { \
        printf '%s\n' \
            'Types: deb' \
            "URIs: $1" \
            'Suites: bookworm bookworm-updates' \
            'Components: main' \
            'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
            '' \
            'Types: deb' \
            "URIs: $2" \
            'Suites: bookworm-security' \
            'Components: main' \
            'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
            > /etc/apt/sources.list.d/debian.sources; \
    }; \
    apt_update_from() { \
        write_debian_sources "$1" "$2"; \
        rm -rf /var/lib/apt/lists/*; \
        echo "Running apt-get update using $1 and $2"; \
        apt-get update \
            -o Acquire::Retries=3 \
            -o Acquire::http::Timeout=20 \
            -o Acquire::https::Timeout=20 \
            -o APT::Update::Error-Mode=any; \
    }; \
    echo "APT security refresh: ${APT_SECURITY_REFRESH}"; \
    if ! apt_update_from "${APT_PRIMARY_MIRROR}" "${APT_PRIMARY_SECURITY_MIRROR}"; then \
        echo "Primary Debian mirror failed; retrying with fallback mirror ${APT_FALLBACK_MIRROR}"; \
        apt_update_from "${APT_FALLBACK_MIRROR}" "${APT_FALLBACK_SECURITY_MIRROR}"; \
    fi; \
    apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        libpq5 \
        libpq-dev \
        libc6-dev \
        gcc \
        tesseract-ocr \
        tesseract-ocr-aze \
    && rm -rf /var/lib/apt/lists/*

ENV TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Create a dedicated non-root user for runtime security.
RUN groupadd --system appgroup \
    && useradd --system --gid appgroup --no-create-home --shell /usr/sbin/nologin appuser

# Upgrade pip, then install Python dependencies.
COPY requirements /app/requirements
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements/production.txt \
    && apt-get purge -y --auto-remove gcc libpq-dev libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the project owned by the runtime user directly (Faza 2, audit
# 2026-07-02): the previous separate `RUN chown -R appuser /app` duplicated
# every copied file into a second image layer (~2x app content).  With
# --chown the ownership is set inside the COPY layer itself.
COPY --chown=appuser:appgroup . /app/

# Entrypoints executable + writable runtime dirs.  Only /app itself and the
# two runtime mount targets are chowned (non-recursive, cheap): staticfiles
# and media are named-volume mountpoints — creating them here appuser-owned
# means FRESH volumes initialise with the correct ownership.
RUN chmod +x /app/docker/release.sh /app/docker/prod-entrypoint.sh \
    && mkdir -p /app/staticfiles /app/media \
    && chown appuser:appgroup /app /app/staticfiles /app/media

# Drop privileges: run the application as a non-root user.  collectstatic
# below then produces appuser-owned files without any recursive chown.
USER appuser

# Build-time arguments: dummy values used only during the collectstatic RUN
# step so that production.py can be imported without real secrets.
# These ARGs are NOT written into the final image's ENV and are never used
# at runtime — runtime values are supplied via docker-compose / orchestrator.
ARG BUILD_SECRET_KEY=build-placeholder-not-for-production
ARG BUILD_DATABASE_URL=sqlite:////tmp/build.db
ARG BUILD_ALLOWED_HOSTS=localhost,127.0.0.1
ARG BUILD_ADMIN_ALLOWED_IPS=127.0.0.1

# Collect static files using only the dummy build-time values.
# Passing them inline to the RUN command ensures they are scoped to this
# single layer and do not persist in the image environment.
RUN SECRET_KEY="${BUILD_SECRET_KEY}" \
    DATABASE_URL="${BUILD_DATABASE_URL}" \
    ALLOWED_HOSTS="${BUILD_ALLOWED_HOSTS}" \
    ADMIN_ALLOWED_IPS="${BUILD_ADMIN_ALLOWED_IPS}" \
    python manage.py collectstatic --noinput

# Expose port
EXPOSE 8000

# Run via the production entrypoint (runs migrations then execs Daphne).
CMD ["/app/docker/prod-entrypoint.sh"]
