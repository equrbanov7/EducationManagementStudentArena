# Production Dockerfile for EMS Arena
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements /app/requirements
RUN pip install --no-cache-dir -r /app/requirements/production.txt

# Copy project
COPY . /app/
RUN chmod +x /app/docker/release.sh /app/docker/prod-entrypoint.sh

# Collect static files
RUN python manage.py collectstatic --noinput

# Expose port
EXPOSE 8000

# Run via the production entrypoint (runs migrations then execs Daphne).
CMD ["/app/docker/prod-entrypoint.sh"]
